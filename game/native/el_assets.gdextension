[configuration]

entry_symbol = "el_assets_init"
compatibility_minimum = "4.7"

[libraries]

linux.x86_64 = "res://native/bin/libel_assets.linux.x86_64.so"
windows.x86_64 = "res://native/bin/el_assets.windows.x86_64.dll"
macos = "res://native/bin/libel_assets.macos.dylib"
android.arm64 = "res://native/bin/libel_assets.android.arm64.so"
android.x86_64 = "res://native/bin/libel_assets.android.x86_64.so"
