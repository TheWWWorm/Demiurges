diff --git a/drivers/vulkan/rendering_device_driver_vulkan.cpp b/drivers/vulkan/rendering_device_driver_vulkan.cpp
index 46c5a4b..5cd6f75 100644
--- a/drivers/vulkan/rendering_device_driver_vulkan.cpp
+++ b/drivers/vulkan/rendering_device_driver_vulkan.cpp
@@ -617,6 +617,24 @@ Error RenderingDeviceDriverVulkan::_initialize_device_extensions() {
 
 	_register_requested_device_extension(VK_KHR_DRIVER_PROPERTIES_EXTENSION_NAME, false);
 
+	if (graphics_sdk != nullptr) {
+		LocalVector<CharString> sdk_required;
+		LocalVector<CharString> sdk_optional;
+		graphics_sdk->get_device_extensions(physical_device, sdk_required, sdk_optional);
+		for (const CharString &extension_name : sdk_required) {
+			if (!requested_device_extensions.has(extension_name)) {
+				_register_requested_device_extension(extension_name, true);
+			} else {
+				requested_device_extensions[extension_name] = true;
+			}
+		}
+		for (const CharString &extension_name : sdk_optional) {
+			if (!requested_device_extensions.has(extension_name)) {
+				_register_requested_device_extension(extension_name, false);
+			}
+		}
+	}
+
 	uint32_t device_extension_count = 0;
 	VkResult err = vkEnumerateDeviceExtensionProperties(physical_device, nullptr, &device_extension_count, nullptr);
 	ERR_FAIL_COND_V_MSG(err != VK_SUCCESS, ERR_CANT_CREATE, vformat("Couldn't get Vulkan device extension count (VkResult error %d).", err));
@@ -1326,9 +1344,230 @@ Error RenderingDeviceDriverVulkan::_add_queue_create_info(LocalVector<VkDeviceQu
 		queue_families[i].resize(create_info.queueCount);
 	}
 
+	// Extra queues for the graphics SDK. They are created after Godot's own
+	// queues in a family and never handed out by command_queue_create().
+	graphics_sdk_queue_requests.clear();
+	if (graphics_sdk != nullptr) {
+		graphics_sdk->get_queue_requests(physical_device, graphics_sdk_queue_requests);
+		static const float sdk_queue_priorities[32] = {};
+		for (GraphicsSDKVulkanProvider::QueueRequest &request : graphics_sdk_queue_requests) {
+			request.family_index = UINT32_MAX;
+			request.first_queue_index = 0;
+			if (request.count == 0) {
+				continue;
+			}
+			uint32_t picked_family = UINT32_MAX;
+			VkQueueFlags picked_flags = VK_QUEUE_FLAG_BITS_MAX_ENUM;
+			for (uint32_t i = 0; i < queue_family_count; i++) {
+				const VkQueueFlags flags = queue_family_properties[i].queueFlags;
+				if ((flags & request.required_flags) != request.required_flags) {
+					continue;
+				}
+				if (request.dedicated_family && (flags & queue_flags_mask) != 0) {
+					continue;
+				}
+				// Prefer the family with the fewest capabilities, like command_queue_family_get().
+				if (flags < picked_flags) {
+					picked_family = i;
+					picked_flags = flags;
+				}
+			}
+			if (picked_family == UINT32_MAX) {
+				print_verbose(vformat("Graphics SDK: no queue family with flags 0x%x for an extra queue.", request.required_flags));
+				continue;
+			}
+			VkDeviceQueueCreateInfo *family_info = nullptr;
+			for (VkDeviceQueueCreateInfo &create_info : r_queue_create_info) {
+				if (create_info.queueFamilyIndex == picked_family) {
+					family_info = &create_info;
+					break;
+				}
+			}
+			const uint32_t used = family_info != nullptr ? family_info->queueCount : 0;
+			if (used + request.count > queue_family_properties[picked_family].queueCount || used + request.count > 32) {
+				print_verbose(vformat("Graphics SDK: queue family %d has no room for %d extra queues.", picked_family, request.count));
+				continue;
+			}
+			if (family_info == nullptr) {
+				VkDeviceQueueCreateInfo create_info = {};
+				create_info.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
+				create_info.queueFamilyIndex = picked_family;
+				create_info.queueCount = request.count;
+				create_info.pQueuePriorities = sdk_queue_priorities;
+				r_queue_create_info.push_back(create_info);
+			} else {
+				family_info->queueCount += request.count;
+				family_info->pQueuePriorities = sdk_queue_priorities;
+			}
+			request.family_index = picked_family;
+			request.first_queue_index = used;
+		}
+	}
+
 	return OK;
 }
 
+void RenderingDeviceDriverVulkan::_graphics_sdk_fold_core_features(void *&r_create_info_next, VkPhysicalDeviceFeatures &r_features) {
+	// The SDK asks for Vulkan 1.2/1.3 core features. Those structs may not be
+	// chained together with the individual structs they replace, so move the
+	// bits Godot already enables into them and unlink the individual ones.
+	const uint32_t api_version = MIN(physical_device_properties.apiVersion, context_driver->application_api_version_get());
+	const bool use_12 = api_version >= VK_API_VERSION_1_2;
+	const bool use_13 = api_version >= VK_API_VERSION_1_3;
+
+	static VkPhysicalDeviceVulkan12Features features_12;
+	static VkPhysicalDeviceVulkan13Features features_13;
+	features_12 = {};
+	features_12.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES;
+	features_13 = {};
+	features_13.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES;
+
+	VkBaseOutStructure *head = (VkBaseOutStructure *)r_create_info_next;
+	VkBaseOutStructure *kept_head = nullptr;
+	VkBaseOutStructure *kept_tail = nullptr;
+	while (head != nullptr) {
+		VkBaseOutStructure *next = head->pNext;
+		bool folded = false;
+		if (use_12) {
+			switch (head->sType) {
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_FLOAT16_INT8_FEATURES: {
+					const VkPhysicalDeviceShaderFloat16Int8Features *f = (const VkPhysicalDeviceShaderFloat16Int8Features *)head;
+					features_12.shaderFloat16 |= f->shaderFloat16;
+					features_12.shaderInt8 |= f->shaderInt8;
+					folded = true;
+				} break;
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_BUFFER_DEVICE_ADDRESS_FEATURES: {
+					const VkPhysicalDeviceBufferDeviceAddressFeatures *f = (const VkPhysicalDeviceBufferDeviceAddressFeatures *)head;
+					features_12.bufferDeviceAddress |= f->bufferDeviceAddress;
+					features_12.bufferDeviceAddressCaptureReplay |= f->bufferDeviceAddressCaptureReplay;
+					features_12.bufferDeviceAddressMultiDevice |= f->bufferDeviceAddressMultiDevice;
+					folded = true;
+				} break;
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_MEMORY_MODEL_FEATURES: {
+					const VkPhysicalDeviceVulkanMemoryModelFeatures *f = (const VkPhysicalDeviceVulkanMemoryModelFeatures *)head;
+					features_12.vulkanMemoryModel |= f->vulkanMemoryModel;
+					features_12.vulkanMemoryModelDeviceScope |= f->vulkanMemoryModelDeviceScope;
+					features_12.vulkanMemoryModelAvailabilityVisibilityChains |= f->vulkanMemoryModelAvailabilityVisibilityChains;
+					folded = true;
+				} break;
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_FEATURES: {
+					features_12.timelineSemaphore |= ((const VkPhysicalDeviceTimelineSemaphoreFeatures *)head)->timelineSemaphore;
+					folded = true;
+				} break;
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_HOST_QUERY_RESET_FEATURES: {
+					features_12.hostQueryReset |= ((const VkPhysicalDeviceHostQueryResetFeatures *)head)->hostQueryReset;
+					folded = true;
+				} break;
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SCALAR_BLOCK_LAYOUT_FEATURES: {
+					features_12.scalarBlockLayout |= ((const VkPhysicalDeviceScalarBlockLayoutFeatures *)head)->scalarBlockLayout;
+					folded = true;
+				} break;
+				default:
+					break;
+			}
+		}
+		if (use_13 && !folded) {
+			switch (head->sType) {
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PIPELINE_CREATION_CACHE_CONTROL_FEATURES: {
+					features_13.pipelineCreationCacheControl |= ((const VkPhysicalDevicePipelineCreationCacheControlFeatures *)head)->pipelineCreationCacheControl;
+					folded = true;
+				} break;
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SYNCHRONIZATION_2_FEATURES: {
+					features_13.synchronization2 |= ((const VkPhysicalDeviceSynchronization2Features *)head)->synchronization2;
+					folded = true;
+				} break;
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_FEATURES: {
+					const VkPhysicalDeviceSubgroupSizeControlFeatures *f = (const VkPhysicalDeviceSubgroupSizeControlFeatures *)head;
+					features_13.subgroupSizeControl |= f->subgroupSizeControl;
+					features_13.computeFullSubgroups |= f->computeFullSubgroups;
+					folded = true;
+				} break;
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TEXTURE_COMPRESSION_ASTC_HDR_FEATURES: {
+					features_13.textureCompressionASTC_HDR |= ((const VkPhysicalDeviceTextureCompressionASTCHDRFeatures *)head)->textureCompressionASTC_HDR;
+					folded = true;
+				} break;
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DYNAMIC_RENDERING_FEATURES: {
+					features_13.dynamicRendering |= ((const VkPhysicalDeviceDynamicRenderingFeatures *)head)->dynamicRendering;
+					folded = true;
+				} break;
+				case VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MAINTENANCE_4_FEATURES: {
+					features_13.maintenance4 |= ((const VkPhysicalDeviceMaintenance4Features *)head)->maintenance4;
+					folded = true;
+				} break;
+				default:
+					break;
+			}
+		}
+		if (!folded) {
+			head->pNext = nullptr;
+			if (kept_tail == nullptr) {
+				kept_head = head;
+			} else {
+				kept_tail->pNext = head;
+			}
+			kept_tail = head;
+		}
+		head = next;
+	}
+
+	VkPhysicalDeviceFeatures2 features_2 = {};
+	features_2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+	features_2.features = r_features;
+	graphics_sdk->adjust_device_features(physical_device, &features_2, use_12 ? &features_12 : nullptr, use_13 ? &features_13 : nullptr);
+
+	// Never enable what the device does not support.
+	VkPhysicalDeviceFeatures supported_features = physical_device_features;
+	VkPhysicalDeviceVulkan12Features supported_12 = {};
+	supported_12.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES;
+	VkPhysicalDeviceVulkan13Features supported_13 = {};
+	supported_13.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES;
+	const RenderingContextDriverVulkan::Functions &functions = context_driver->functions_get();
+	bool have_supported = false;
+	if (functions.GetPhysicalDeviceFeatures2 != nullptr && use_12) {
+		have_supported = true;
+		VkPhysicalDeviceFeatures2 query = {};
+		query.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+		query.pNext = &supported_12;
+		if (use_13) {
+			supported_12.pNext = &supported_13;
+		}
+		functions.GetPhysicalDeviceFeatures2(physical_device, &query);
+		supported_features = query.features;
+	}
+	{
+		VkBool32 *requested = (VkBool32 *)&features_2.features;
+		const VkBool32 *supported = (const VkBool32 *)&supported_features;
+		for (uint32_t i = 0; i < sizeof(VkPhysicalDeviceFeatures) / sizeof(VkBool32); i++) {
+			requested[i] = requested[i] && supported[i];
+		}
+		r_features = features_2.features;
+	}
+
+	const auto mask_bools = [](VkBool32 *p_requested, const VkBool32 *p_supported, size_t p_bytes) {
+		for (size_t i = 0; i < p_bytes / sizeof(VkBool32); i++) {
+			p_requested[i] = p_requested[i] && p_supported[i];
+		}
+	};
+	if (have_supported) {
+		// Every member after sType and pNext is a VkBool32 in both structs.
+		const size_t header = offsetof(VkPhysicalDeviceVulkan12Features, samplerMirrorClampToEdge);
+		mask_bools((VkBool32 *)((uint8_t *)&features_12 + header), (const VkBool32 *)((const uint8_t *)&supported_12 + header), sizeof(features_12) - header);
+		const size_t header_13 = offsetof(VkPhysicalDeviceVulkan13Features, robustImageAccess);
+		mask_bools((VkBool32 *)((uint8_t *)&features_13 + header_13), (const VkBool32 *)((const uint8_t *)&supported_13 + header_13), sizeof(features_13) - header_13);
+	}
+
