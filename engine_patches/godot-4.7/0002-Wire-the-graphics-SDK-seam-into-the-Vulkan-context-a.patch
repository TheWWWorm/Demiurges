+VkResult RenderingContextDriverVulkanWindows::_create_win32_surface(HWND p_window, HINSTANCE p_instance, bool p_graphics_sdk, VkSurfaceKHR *r_surface) {
+	VkWin32SurfaceCreateInfoKHR create_info = {};
+	create_info.sType = VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR;
+	create_info.hinstance = p_instance;
+	create_info.hwnd = p_window;
+
+	PFN_vkCreateWin32SurfaceKHR create_surface = vkCreateWin32SurfaceKHR;
+	if (p_graphics_sdk) {
+		create_surface = (PFN_vkCreateWin32SurfaceKHR)_graphics_sdk_create_surface_get();
+	}
+	return create_surface(instance_get(), &create_info, get_allocation_callbacks(VK_OBJECT_TYPE_SURFACE_KHR), r_surface);
