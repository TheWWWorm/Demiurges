From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: WWWorm <noreply@localhost>
Date: Thu, 12 Nov 2026 11:28:17 +0100
Subject: [PATCH] Wire the graphics SDK seam into the Vulkan context and device
 drivers

An SDK owner can add instance and device extensions, core features and
extra queues, hook swapchain, present and surface functions, and wrap
presentation. Without an owner the drivers behave as before.
---
 drivers/vulkan/graphics_sdk_vulkan.h          |  16 +
 .../rendering_context_driver_vulkan.cpp       |  55 ++-
 .../vulkan/rendering_context_driver_vulkan.h  |  21 +
 .../vulkan/rendering_device_driver_vulkan.cpp | 358 +++++++++++++++++-
 .../vulkan/rendering_device_driver_vulkan.h   |  11 +
 ...endering_context_driver_vulkan_windows.cpp |  40 +-
 .../rendering_context_driver_vulkan_windows.h |   2 +
 servers/rendering/rendering_device_driver.h   |   3 +
 8 files changed, 497 insertions(+), 9 deletions(-)
 mode change 100755 => 100644 drivers/vulkan/graphics_sdk_vulkan.h

diff --git a/drivers/vulkan/graphics_sdk_vulkan.h b/drivers/vulkan/graphics_sdk_vulkan.h
old mode 100755
new mode 100644
index 1d75b6c..3e9737d
--- a/drivers/vulkan/graphics_sdk_vulkan.h
+++ b/drivers/vulkan/graphics_sdk_vulkan.h
@@ -59,6 +59,16 @@ public:
 		PFN_vkDeviceWaitIdle device_wait_idle = nullptr;
 	};
 
+	// Window-surface entry points. Like the swapchain table, unset entries keep
+	// the loader's function. create_win32_surface is a PFN_vkCreateWin32SurfaceKHR
+	// (kept untyped so this header stays platform-neutral). Queried after
+	// device_created; surfaces created earlier are recreated through it before
+	// their first swapchain.
+	struct SurfaceFunctions {
+		PFN_vkVoidFunction create_win32_surface = nullptr;
+		PFN_vkDestroySurfaceKHR destroy_surface = nullptr;
+	};
+
 	// Extra queues the provider needs created alongside Godot's own.
 	struct QueueRequest {
 		VkQueueFlags required_flags = 0;
@@ -96,6 +106,10 @@ public:
 		uint32_t graphics_queue_index = 0;
 		VkQueue graphics_queue = VK_NULL_HANDLE;
 		LocalVector<QueueRequest> extra_queues; // as requested, with indices filled.
+		// Device extensions actually enabled (optional requests may be missing).
+		LocalVector<CharString> enabled_device_extensions;
+		// VkApplicationInfo::apiVersion the instance was created with.
+		uint32_t instance_api_version = VK_API_VERSION_1_0;
 	};
 	// After vkCreateDevice. Returning false disables the provider for this
 	// run (ordinary rendering continues).
@@ -105,6 +119,8 @@ public:
 	// Called once after device_created; the provider overwrites the entries
 	// it takes over.
 	virtual void get_swapchain_functions(SwapchainFunctions &r_functions) {}
+	// Called once after get_swapchain_functions.
+	virtual void get_surface_functions(SurfaceFunctions &r_functions) {}
 
 	// Frame markers around the driver's present.
 	virtual void present_begin(uint64_t p_frame) {}
diff --git a/drivers/vulkan/rendering_context_driver_vulkan.cpp b/drivers/vulkan/rendering_context_driver_vulkan.cpp
index 96f633f..28a25b3 100644
--- a/drivers/vulkan/rendering_context_driver_vulkan.cpp
+++ b/drivers/vulkan/rendering_context_driver_vulkan.cpp
@@ -35,6 +35,7 @@
 #include "core/config/engine.h"
 #include "core/config/project_settings.h"
 #include "core/version.h"
+#include "drivers/vulkan/graphics_sdk_vulkan.h"
 #include "drivers/vulkan/rendering_device_driver_vulkan.h"
 #include "drivers/vulkan/vulkan_hooks.h"
 
@@ -460,6 +461,25 @@ Error RenderingContextDriverVulkan::_initialize_instance_extensions() {
 		_register_requested_instance_extension(VK_EXT_DEBUG_UTILS_EXTENSION_NAME, false);
 	}
 
+	// Extensions needed by the graphics SDK that owns this run (if any).
+	if (GraphicsSDKVulkan::get_owner() != nullptr && VulkanHooks::get_singleton() == nullptr) {
+		LocalVector<CharString> sdk_required;
+		LocalVector<CharString> sdk_optional;
+		GraphicsSDKVulkan::get_owner()->get_instance_extensions(sdk_required, sdk_optional);
+		for (const CharString &extension_name : sdk_required) {
+			if (!requested_instance_extensions.has(extension_name)) {
+				_register_requested_instance_extension(extension_name, true);
+			} else {
+				requested_instance_extensions[extension_name] = true;
+			}
+		}
+		for (const CharString &extension_name : sdk_optional) {
+			if (!requested_instance_extensions.has(extension_name)) {
+				_register_requested_instance_extension(extension_name, false);
+			}
+		}
+	}
+
 	// Load instance extensions that are available.
 	uint32_t instance_extension_count = 0;
 	VkResult err = vkEnumerateInstanceExtensionProperties(nullptr, &instance_extension_count, nullptr);
@@ -687,7 +707,14 @@ Error RenderingContextDriverVulkan::_initialize_instance() {
 	// We'll set application version to the Vulkan version we're developing against, even if our instance is based on an older Vulkan
 	// version, devices can still support newer versions of Vulkan. The exception is when we're on Vulkan 1.0, we should not set this
 	// to anything but 1.0. Note that this value is only used by validation layers to warn us about version issues.
-	uint32_t application_api_version = instance_api_version == VK_API_VERSION_1_0 ? VK_API_VERSION_1_0 : VK_API_VERSION_1_2;
+	application_api_version = instance_api_version == VK_API_VERSION_1_0 ? VK_API_VERSION_1_0 : VK_API_VERSION_1_2;
+	if (GraphicsSDKVulkan::get_owner() != nullptr && VulkanHooks::get_singleton() == nullptr) {
+		// A graphics SDK may need newer core feature structs (Vulkan 1.3) on the device.
+		const uint32_t sdk_api_version = GraphicsSDKVulkan::get_owner()->get_minimum_api_version();
+		if (sdk_api_version > application_api_version && instance_api_version >= sdk_api_version) {
+			application_api_version = sdk_api_version;
+		}
+	}
 
 	CharString cs = GLOBAL_GET("application/config/name").operator String().utf8();
 	VkApplicationInfo app_info = {};
@@ -745,6 +772,10 @@ Error RenderingContextDriverVulkan::_initialize_instance() {
 	volkLoadInstance(instance);
 #endif
 
+	if (GraphicsSDKVulkan::get_owner() != nullptr && VulkanHooks::get_singleton() == nullptr) {
+		GraphicsSDKVulkan::get_owner()->instance_created(instance, vkGetInstanceProcAddr);
+	}
+
 	// Physical device.
 	if (enabled_instance_extension_names.has(VK_KHR_GET_PHYSICAL_DEVICE_PROPERTIES_2_EXTENSION_NAME)) {
 		functions.GetPhysicalDeviceFeatures2 = PFN_vkGetPhysicalDeviceFeatures2(vkGetInstanceProcAddr(instance, "vkGetPhysicalDeviceFeatures2"));
@@ -1038,10 +1069,30 @@ bool RenderingContextDriverVulkan::surface_get_needs_resize(SurfaceID p_surface)
 
 void RenderingContextDriverVulkan::surface_destroy(SurfaceID p_surface) {
 	Surface *surface = (Surface *)(p_surface);
-	vkDestroySurfaceKHR(instance, surface->vk_surface, get_allocation_callbacks(VK_OBJECT_TYPE_SURFACE_KHR));
+	if (surface->graphics_sdk_surface && graphics_sdk_destroy_surface != nullptr) {
+		graphics_sdk_destroy_surface(instance, surface->vk_surface, get_allocation_callbacks(VK_OBJECT_TYPE_SURFACE_KHR));
+	} else {
+		vkDestroySurfaceKHR(instance, surface->vk_surface, get_allocation_callbacks(VK_OBJECT_TYPE_SURFACE_KHR));
+	}
 	memdelete(surface);
 }
 
+void RenderingContextDriverVulkan::graphics_sdk_surface_functions_set(PFN_vkVoidFunction p_create, PFN_vkDestroySurfaceKHR p_destroy) {
+	graphics_sdk_create_surface = p_create;
+	graphics_sdk_destroy_surface = p_destroy;
+}
+
+void RenderingContextDriverVulkan::surface_prepare_for_graphics_sdk(SurfaceID p_surface) {
+	Surface *surface = (Surface *)(p_surface);
+	if (surface == nullptr || surface->graphics_sdk_surface || graphics_sdk_create_surface == nullptr) {
+		return;
+	}
+	// Only valid while no swapchain references the old surface.
+	if (!_surface_recreate_for_graphics_sdk(p_surface)) {
+		WARN_PRINT("Graphics SDK: Couldn't recreate the window surface through the SDK; keeping the original surface.");
+	}
+}
+
 bool RenderingContextDriverVulkan::is_debug_utils_enabled() const {
 	return enabled_instance_extension_names.has(VK_EXT_DEBUG_UTILS_EXTENSION_NAME);
 }
diff --git a/drivers/vulkan/rendering_context_driver_vulkan.h b/drivers/vulkan/rendering_context_driver_vulkan.h
