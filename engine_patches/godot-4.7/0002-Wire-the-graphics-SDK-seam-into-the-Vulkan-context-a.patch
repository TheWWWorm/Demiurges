+
+bool RenderingContextDriverVulkanWindows::_surface_recreate_for_graphics_sdk(SurfaceID p_surface) {
+	Surface *surface = (Surface *)(p_surface);
+	if (surface->platform_window == nullptr) {
+		return false;
+	}
+	VkSurfaceKHR vk_surface = VK_NULL_HANDLE;
+	VkResult err = _create_win32_surface((HWND)surface->platform_window, (HINSTANCE)surface->platform_instance, true, &vk_surface);
+	if (err != VK_SUCCESS) {
+		return false;
+	}
+	vkDestroySurfaceKHR(instance_get(), surface->vk_surface, get_allocation_callbacks(VK_OBJECT_TYPE_SURFACE_KHR));
+	surface->vk_surface = vk_surface;
+	surface->graphics_sdk_surface = true;
+	return true;
+}
