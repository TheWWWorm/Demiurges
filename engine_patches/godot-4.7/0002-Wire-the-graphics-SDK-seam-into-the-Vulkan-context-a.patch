+void RenderingDeviceDriverVulkan::_graphics_sdk_device_created() {
+	const RenderingContextDriverVulkan::Functions &functions = context_driver->functions_get();
+
+	GraphicsSDKVulkanProvider::DeviceInfo info;
+	info.instance = context_driver->instance_get();
+	info.physical_device = physical_device;
+	info.device = vk_device;
+	info.get_instance_proc_addr = vkGetInstanceProcAddr;
+	info.get_device_proc_addr = functions.GetDeviceProcAddr;
+	info.instance_api_version = context_driver->application_api_version_get();
+
+	// The main queue is the one command_queue_family_get() picks for graphics:
+	// the graphics family with the fewest capabilities, queue 0.
+	VkQueueFlags picked_flags = VK_QUEUE_FLAG_BITS_MAX_ENUM;
+	for (uint32_t i = 0; i < queue_family_properties.size(); i++) {
+		if (queue_families[i].is_empty() || !(queue_family_properties[i].queueFlags & VK_QUEUE_GRAPHICS_BIT)) {
+			continue;
+		}
+		if (queue_family_properties[i].queueFlags < picked_flags) {
+			picked_flags = queue_family_properties[i].queueFlags;
+			info.graphics_queue_family = i;
+		}
+	}
+	if (info.graphics_queue_family != UINT32_MAX) {
+		info.graphics_queue_index = 0;
+		info.graphics_queue = queue_families[info.graphics_queue_family][0].queue;
+	}
+	for (const GraphicsSDKVulkanProvider::QueueRequest &request : graphics_sdk_queue_requests) {
+		info.extra_queues.push_back(request);
+	}
+	for (const CharString &extension_name : enabled_device_extension_names) {
+		info.enabled_device_extensions.push_back(extension_name);
+	}
+
+	if (!graphics_sdk->device_created(info)) {
+		print_line(vformat("Graphics SDK %s declined the Vulkan device; continuing without it.", graphics_sdk->get_name()));
+		graphics_sdk = nullptr;
+		return;
+	}
+
+	GraphicsSDKVulkanProvider::SwapchainFunctions swapchain_functions;
+	swapchain_functions.create_swapchain = device_functions.CreateSwapchainKHR;
+	swapchain_functions.destroy_swapchain = device_functions.DestroySwapchainKHR;
+	swapchain_functions.get_swapchain_images = device_functions.GetSwapchainImagesKHR;
+	swapchain_functions.acquire_next_image = device_functions.AcquireNextImageKHR;
+	swapchain_functions.queue_present = device_functions.QueuePresentKHR;
+	swapchain_functions.device_wait_idle = nullptr;
+	graphics_sdk->get_swapchain_functions(swapchain_functions);
+	if (swapchain_functions.create_swapchain != nullptr) {
+		device_functions.CreateSwapchainKHR = swapchain_functions.create_swapchain;
+	}
+	if (swapchain_functions.destroy_swapchain != nullptr) {
+		device_functions.DestroySwapchainKHR = swapchain_functions.destroy_swapchain;
+	}
+	if (swapchain_functions.get_swapchain_images != nullptr) {
+		device_functions.GetSwapchainImagesKHR = swapchain_functions.get_swapchain_images;
+	}
+	if (swapchain_functions.acquire_next_image != nullptr) {
+		device_functions.AcquireNextImageKHR = swapchain_functions.acquire_next_image;
+	}
+	if (swapchain_functions.queue_present != nullptr) {
+		device_functions.QueuePresentKHR = swapchain_functions.queue_present;
+	}
+	device_functions.DeviceWaitIdle = swapchain_functions.device_wait_idle;
+
+	GraphicsSDKVulkanProvider::SurfaceFunctions surface_functions;
+	graphics_sdk->get_surface_functions(surface_functions);
+	context_driver->graphics_sdk_surface_functions_set(surface_functions.create_win32_surface, surface_functions.destroy_surface);
+}
