 }
 
+// Poll background compilation without making the render thread join it.
+bool ShaderRD::is_group_compilation_ready(int p_group) {
+	ERR_FAIL_INDEX_V(p_group, group_enabled.size(), false);
+	if (!group_enabled[p_group]) { return false; }
+	for (const RID &version_rid : version_owner.get_owned_list()) {
+		const Version *version = version_owner.get_or_null(version_rid);
+		// Another compiler may hold this mutex while joining a shader job.
+		// A readiness poll must never wait for that mutex either.
+		if (!version->mutex->try_lock()) { return false; }
+		bool ready = true;
+		if (!version->dirty && version->group_compilation_tasks.size() > p_group) {
+			WorkerThreadPool::GroupID task = version->group_compilation_tasks[p_group];
+			ready = task == 0 || WorkerThreadPool::get_singleton()->is_group_task_completed(task);
+		}
+		version->mutex->unlock();
+		if (!ready) { return false; }
+	}
+	return true;
+}
+
 int64_t ShaderRD::get_group_count() const {
 	return group_enabled.size();
 }
