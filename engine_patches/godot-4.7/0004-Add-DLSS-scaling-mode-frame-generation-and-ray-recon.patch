+void RendererViewport::viewport_set_frame_generation(RID p_viewport, bool p_frame_generation) {
+	Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	ERR_FAIL_NULL(viewport);
+
+	if (viewport->frame_generation == p_frame_generation) { return; }
+	const bool motion_vectors_before = _viewport_requires_motion_vectors(viewport);
+	viewport->frame_generation = p_frame_generation;
+	const bool motion_vectors_after = _viewport_requires_motion_vectors(viewport);
+	if (motion_vectors_before != motion_vectors_after) {
+		num_viewports_with_motion_vectors += motion_vectors_after ? 1 : -1;
+	}
+	if (viewport->render_buffers.is_valid()) { viewport->render_buffers->set_frame_generation(p_frame_generation); }
+}
