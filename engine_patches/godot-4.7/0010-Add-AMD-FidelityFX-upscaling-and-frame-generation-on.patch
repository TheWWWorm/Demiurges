+// AMD FidelityFX (FSR SDK) on the Vulkan driver: FSR 3.1 / FSR 4 upscaling
+// and frame generation through the SDK's replacement swapchain.
+//
+// Upscaling works whenever the pinned runtime DLLs load and the SDK reports a
+// provider for the GPU. Frame generation also needs this driver to own
+// presentation for the run (startup owner "amd"), because the swapchain and
+// four separate queues must be set up when the device is created.
+
+#include "core/object/class_db.h"
+#include "core/object/object.h"
+#include "core/os/mutex.h"
