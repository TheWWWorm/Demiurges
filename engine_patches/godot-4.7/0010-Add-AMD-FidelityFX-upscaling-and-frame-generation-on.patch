+// Temporal inputs for the AMD FSR SDK, independent of other upscalers.
+class FSRSDKContext {
+public:
+	struct Parameters {
+		FSRSDKContext *context = nullptr;
+		Size2i internal_size;
+		RID color, depth, velocity, output;
+		float z_near = 0.1f, z_far = 1000.0f, fovy = 70.0f;
+		Vector2 jitter;
+		float delta_time = 0.0f, sharpness = 0.0f;
+		bool reset_accumulation = false, frame_generation = false;
+		Projection reprojection;
+		Transform3D cam_transform;
+	} last_parameters;
+	virtual ~FSRSDKContext() {}
+};
+
+class FSRSDKEffect {
+	FsrSdkPrepareShaderRD shader;
+	RID shader_version;
+	RID pipeline;
+	static void upscale_callback(RenderingDeviceDriver *p_driver, RenderingDeviceDriver::CommandBufferID p_commands, void *p_userdata);
+	static void frame_generation_callback(RenderingDeviceDriver *p_driver, RenderingDeviceDriver::CommandBufferID p_commands, void *p_userdata);
+
+public:
+	FSRSDKEffect();
+	~FSRSDKEffect();
+	FSRSDKContext *create_context(Size2i p_internal, Size2i p_target, bool p_upscaling);
+	bool is_version_current(FSRSDKContext *p_context, bool p_upscaling) const;
+	void process(const FSRSDKContext::Parameters &p_params);
+	void prepare_frame_generation(FSRSDKContext *p_context, RID p_color);
+};
+
+} // namespace RendererRD
