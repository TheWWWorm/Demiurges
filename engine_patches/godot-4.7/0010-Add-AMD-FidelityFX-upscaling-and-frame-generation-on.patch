+#include "thirdparty/amd-fsr-sdk/framegeneration/include/ffx_framegeneration.h"
+#include "thirdparty/amd-fsr-sdk/upscalers/include/ffx_upscale.h"
+#endif
+
+class FidelityFX : public Object {
+	GDCLASS(FidelityFX, Object);
+
+	static FidelityFX *singleton;
+	static void _bind_methods();
+
+	mutable Mutex status_mutex;
+
+public:
+	SafeNumeric<uint32_t> sr_version{ 3 };
+	SafeNumeric<uint32_t> fg_version{ 0 };
+
+	FidelityFX();
+	~FidelityFX();
+	static FidelityFX *get_singleton() { return singleton; }
+	static void register_singleton();
+
+	Dictionary get_status() const;
+	void set_upscaler_version(int p_version);
+	void set_frame_generation_version(int p_version);
+	bool sr_available() const;
+	int get_upscaler_version() const { return sr_version.get(); }
+
+	// Startup, before the display server creates the Vulkan context.
+	void select_presentation_owner();
+
+#ifdef FSR_SDK_ENABLED
+	struct VulkanState;
+	VulkanState *vk = nullptr; // Vulkan handles; defined in fsr_sdk.cpp.
+
+	PfnFfxCreateContext create = nullptr;
+	PfnFfxDestroyContext destroy = nullptr;
+	PfnFfxQuery query = nullptr;
+	PfnFfxDispatch dispatch = nullptr;
+	PfnFfxConfigure configure = nullptr;
+
+	bool runtime_attempted = false;
+	bool runtime_loaded = false;
+	String runtime_reason;
+	bool presentation_owner = false;
+	bool device_ready = false;
+	String owner_reason;
+
+	uint64_t sr_ids[2]{};
+	uint64_t fg_ids[2]{};
+	bool sr_supported[2]{};
+	bool fg_supported[2]{};
+	String sr_reason[2];
+	String fg_reason[2];
+	String sr_versions_found;
+	String fg_versions_found;
+	String swapchain_versions_found;
+
+	SafeNumeric<uint64_t> sr_evaluations{ 0 };
+	SafeNumeric<uint64_t> fg_dispatches{ 0 };
+	SafeNumeric<uint64_t> generated_frames{ 0 };
+	SafeNumeric<uint64_t> game_presents{ 0 };
+	SafeNumeric<uint64_t> presented_frames{ 0 };
+	SafeNumeric<uint32_t> present_count_available{ 0 };
+	uint64_t last_present_count = 0;
+	SafeNumeric<uint32_t> sr_failed{ 0 };
+	SafeNumeric<uint32_t> fg_failed{ 0 };
+	SafeNumeric<uint32_t> last_error{ 0 };
+	SafeNumeric<uint32_t> fg_active{ 0 };
+	SafeNumeric<uint32_t> temporal_shaders_initializing{ 0 };
+	SafeNumeric<uint64_t> swapchain_creations{ 0 };
+
+	Mutex fg_mutex;
+	ffxContext fg_context = nullptr;
+	ffxContext swap_context = nullptr;
+	uint64_t swap_chain = 0; // VkSwapchainKHR of the frame generation swapchain, or 0.
+	uint32_t swap_format = 0; // FfxApiSurfaceFormat of the backbuffer.
+	uint32_t swap_width = 0;
+	uint32_t swap_height = 0;
+	String swap_provider;
+	String swap_reason;
+	uint64_t frame_id = 0;
+	bool prepared = false;
+	int active_fg_version = 0;
+	String sr_provider;
+	String fg_provider;
+	ffxCreateContextDescFrameGeneration fg_desc{};
+	ffxConfigureDescFrameGeneration fg_config{};
+	bool debug_frames = false;
+
+	// Only the worker touches a pending context. Rendering adopts it after
+	// completion; disabling/resizing never waits for first-use compilation.
+	struct ContextJob {
+		FidelityFX *api = nullptr;
+		Thread thread;
+		SafeNumeric<uint32_t> done{ 0 };
+		bool fg = false;
+		int version = 0;
+		Size2i render_size, target_size;
+		uint32_t hudless_format = 0;
+		uint32_t back_buffer_format = 0;
+		ffxContext context = nullptr;
+		ffxReturnCode_t result = FFX_API_RETURN_OK;
+	};
+	ContextJob *context_job = nullptr; // Render thread owns the bounded, single slot.
+	SafeNumeric<uint32_t> initializing_effect{ 0 };
+	SafeNumeric<uint64_t> sr_create_usec{ 0 }, fg_create_usec{ 0 };
+	SafeNumeric<uint64_t> sr_max_dispatch_usec{ 0 }, prepare_max_usec{ 0 };
+	SafeNumeric<uint64_t> sr_context_creations{ 0 }, fg_context_creations{ 0 };
+	static void create_context_worker(void *p_userdata);
+
+	bool load_runtime();
+	void query_versions();
+	// Without presentation ownership, adopt the device RenderingDevice created.
+	void initialize_from_rendering_device();
+	void shutdown_device();
+
+	ffxContext request_context(bool p_fg, int p_version, Size2i p_render, Size2i p_target, uint32_t p_hudless_format = 0);
+	void finish_context_job(); // Only shutdown may wait for an unfinished job.
+
+	// Native SDK description of an RD texture. p_state is an FfxApiResourceState
+	// matching the layout the render graph put the texture in.
+	FfxApiResource get_resource(RID p_texture, uint32_t p_state, uint32_t p_additional_usage = 0) const;
+
+	void release_frame_generation();
+	void wait_for_presents();
+	void disable_frame_generation(); // Caller holds fg_mutex.
+	bool ensure_frame_generation(Size2i p_render, Size2i p_target, uint32_t p_hudless_format);
+	bool check(ffxReturnCode_t p_code, bool p_fg = false);
+	void record_provider(ffxContext *p_context, bool p_fg);
+	static ffxReturnCode_t generate(ffxDispatchDescFrameGeneration *p_desc, void *p_user);
+#endif
+};
