+void FidelityFX::select_presentation_owner() {
+#ifdef FSR_SDK_ENABLED
+	if (Engine::get_singleton()->is_editor_hint()) {
+		owner_reason = "not used in the editor";
+		return;
+	}
+	if (GraphicsSDKVulkan::get_requested_owner() != "amd") {
+		owner_reason = "presentation owner is not amd";
+		return;
+	}
+	if (OS::get_singleton()->get_current_rendering_method() != "forward_plus" || OS::get_singleton()->get_current_rendering_driver_name() != "vulkan") {
+		owner_reason = "needs the Forward+ renderer on Vulkan";
+		return;
+	}
+	if (!load_runtime()) {
+		owner_reason = runtime_reason;
+		return;
+	}
+	if (!GraphicsSDKVulkan::select_owner(&vulkan_provider)) {
+		owner_reason = vformat("presentation is owned by %s", GraphicsSDKVulkan::get_owner()->get_name());
+		return;
+	}
+	presentation_owner = true;
+	debug_frames = OS::get_singleton()->get_cmdline_user_args().find("--fsr-debug-frames") != nullptr;
+#endif
+}
