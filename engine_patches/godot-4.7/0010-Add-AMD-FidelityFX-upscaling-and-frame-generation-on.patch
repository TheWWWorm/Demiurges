+#ifdef FSR_SDK_ENABLED
+
+bool FidelityFX::load_runtime() {
+	if (runtime_attempted) {
+		return runtime_loaded;
+	}
+	runtime_attempted = true;
+	// Only the pinned, signed SDK binaries beside the executable; never the
+	// working directory or the DLL search path.
+	const String base_dir = OS::get_singleton()->get_executable_path().get_base_dir();
+	HMODULE loader = nullptr;
+	for (const FSRSDKRuntimeFile &file : FSR_SDK_RUNTIME_FILES) {
+		const String path = base_dir.path_join(file.name);
+		if (!FileAccess::exists(path)) {
+			runtime_reason = vformat("%s is missing", file.name);
+			break;
+		}
+		if (FileAccess::get_sha256(path) != file.sha256) {
+			runtime_reason = vformat("%s does not match the pinned AMD FSR SDK %s", file.name, FSR_SDK_PINNED_VERSION);
+			break;
+		}
+		const Char16String wide = path.replace("/", "\\").utf16();
+		HMODULE module = LoadLibraryExW((LPCWSTR)wide.get_data(), nullptr, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+		if (!module) {
+			runtime_reason = vformat("%s could not be loaded (error %d)", file.name, (int64_t)GetLastError());
+			break;
+		}
+		// Modules stay loaded until exit; effect callbacks outlive frames.
+		loader = module;
+	}
+	if (runtime_reason.is_empty() && loader) {
+		create = (PfnFfxCreateContext)(void *)GetProcAddress(loader, "ffxCreateContext");
+		destroy = (PfnFfxDestroyContext)(void *)GetProcAddress(loader, "ffxDestroyContext");
+		query = (PfnFfxQuery)(void *)GetProcAddress(loader, "ffxQuery");
+		dispatch = (PfnFfxDispatch)(void *)GetProcAddress(loader, "ffxDispatch");
+		configure = (PfnFfxConfigure)(void *)GetProcAddress(loader, "ffxConfigure");
+		if (!create || !destroy || !query || !dispatch || !configure) {
+			runtime_reason = "the AMD FSR loader does not export the FidelityFX API";
+		}
+	}
+	runtime_loaded = runtime_reason.is_empty();
+	if (!runtime_loaded) {
+		WARN_PRINT("FidelityFX unavailable: " + runtime_reason + ".");
+		for (int i = 0; i < 2; i++) {
+			sr_reason[i] = runtime_reason;
+			fg_reason[i] = runtime_reason;
+		}
+	}
+	return runtime_loaded;
+}
+
+void FidelityFX::initialize_from_rendering_device() {
+	if (device_ready) {
+		return;
+	}
+	RenderingDevice *rd = RenderingDevice::get_singleton();
+	String reason;
+	if (Engine::get_singleton()->is_editor_hint()) {
+		reason = "not used in the editor";
+	} else if (!rd || rd->get_device_api_name() != "Vulkan" || OS::get_singleton()->get_current_rendering_method() != "forward_plus") {
+		reason = "needs the Forward+ renderer on Vulkan";
+	} else if (!load_runtime()) {
+		reason = runtime_reason;
+	}
+	if (!reason.is_empty()) {
+		for (int i = 0; i < 2; i++) {
+			sr_reason[i] = reason;
+			fg_reason[i] = reason;
+		}
+		return;
+	}
+	vk->instance = (VkInstance)rd->get_driver_resource(RD::DRIVER_RESOURCE_TOPMOST_OBJECT);
+	vk->physical_device = (VkPhysicalDevice)rd->get_driver_resource(RD::DRIVER_RESOURCE_PHYSICAL_DEVICE);
+	vk->device = (VkDevice)rd->get_driver_resource(RD::DRIVER_RESOURCE_LOGICAL_DEVICE);
+	vk->device_context.vkDevice = vk->device;
+	vk->device_context.vkPhysicalDevice = vk->physical_device;
+	vk->device_context.vkDeviceProcAddr = vkGetDeviceProcAddr;
+	device_ready = vk->device != VK_NULL_HANDLE;
+	if (device_ready) {
+		query_versions();
+	}
+}
+
+void FidelityFX::query_versions() {
+	struct Effect {
+		uint64_t type;
+		uint64_t *ids;
+		bool *supported;
+		String *reasons;
+		String *found;
+	};
+	Effect effects[3] = {
+		{ FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE, sr_ids, sr_supported, sr_reason, &sr_versions_found },
+		{ FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION, fg_ids, fg_supported, fg_reason, &fg_versions_found },
+		{ FFX_API_CREATE_CONTEXT_DESC_TYPE_FGSWAPCHAIN_VK, nullptr, nullptr, nullptr, &swapchain_versions_found },
+	};
+	for (Effect &effect : effects) {
+		uint64_t count = 32;
+		uint64_t ids[32] = {};
+		const char *names[32] = {};
+		ffxQueryDescGetVersions q = {};
+		q.header.type = FFX_API_QUERY_DESC_TYPE_GET_VERSIONS;
+		q.createDescType = effect.type;
+		q.device = &vk->device_context;
+		q.outputCount = &count;
+		q.versionIds = ids;
+		q.versionNames = names;
+		const ffxReturnCode_t code = query(nullptr, &q.header);
+		PackedStringArray found;
+		if (code == FFX_API_RETURN_OK) {
+			for (uint64_t i = 0; i < MIN(count, uint64_t(32)); i++) {
+				// Names may live in shared SDK memory; copy them right away.
+				const String name = names[i] ? String::utf8(names[i]) : String();
+				found.push_back(name);
+				int major = 0;
+				int minor = 0;
+				if (!effect.ids || !parse_provider_version(name, major, minor)) {
+					continue;
+				}
+				const int index = (major == 3 && minor >= 1) ? 0 : (major == 4 ? 1 : -1);
+				if (index < 0 || effect.supported[index]) {
+					continue;
+				}
+				// Version ids are opaque; only reuse ids returned for this device.
+				effect.ids[index] = ids[i];
+				effect.supported[index] = true;
+			}
+		}
+		*effect.found = String(", ").join(found);
+		print_line(vformat("FidelityFX %s providers: %s", effect.type == FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE ? "upscaler" : (effect.type == FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION ? "frame generation" : "swapchain"), found.is_empty() ? vformat("none (SDK result %d)", code) : *effect.found));
+		if (!effect.ids) {
+			continue;
+		}
+		for (int i = 0; i < 2; i++) {
+			if (!effect.supported[i]) {
+				effect.reasons[i] = code == FFX_API_RETURN_OK ? vformat("the SDK reports no FSR %s provider for this GPU", i == 0 ? "3.1" : "4") : vformat("the SDK version query failed (error %d)", code);
+			} else {
+				effect.reasons[i] = String();
+			}
+		}
+	}
+	// Frame generation additionally needs presentation and its queues.
+	for (int i = 0; i < 2; i++) {
+		if (!fg_supported[i]) {
+			continue;
+		}
+		if (!presentation_owner) {
+			fg_supported[i] = false;
+			fg_reason[i] = owner_reason.is_empty() ? String("presentation owner is not amd") : owner_reason;
+		} else if (!vk->queues_ready) {
+			fg_supported[i] = false;
+			fg_reason[i] = "the GPU cannot provide the four separate Vulkan queues frame generation needs";
+		}
+	}
+}
+
+void FidelityFX::shutdown_device() {
+	finish_context_job();
+	device_ready = false;
+}
+
+FfxApiResource FidelityFX::get_resource(RID p_texture, uint32_t p_state, uint32_t p_additional_usage) const {
+	RenderingDevice *rd = RenderingDevice::get_singleton();
+	const VkImage image = (VkImage)rd->get_driver_resource(RD::DRIVER_RESOURCE_TEXTURE, p_texture);
+	const RD::TextureFormat format = rd->texture_get_format(p_texture);
+	VkImageCreateInfo info = {};
+	info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+	info.imageType = VK_IMAGE_TYPE_2D;
+	info.format = (VkFormat)rd->get_driver_resource(RD::DRIVER_RESOURCE_TEXTURE_DATA_FORMAT, p_texture);
+	info.extent = { format.width, format.height, 1 };
+	info.mipLevels = format.mipmaps;
+	info.arrayLayers = format.array_layers;
+	if (format.usage_bits & RD::TEXTURE_USAGE_STORAGE_BIT) {
+		info.usage |= VK_IMAGE_USAGE_STORAGE_BIT;
+	}
+	FfxApiResourceDescription description = ffxApiGetImageResourceDescriptionVK(image, info, p_additional_usage);
+	return ffxApiGetResourceVK((void *)image, description, p_state);
+}
+
+void FidelityFX::create_context_worker(void *p_userdata) {
+	ContextJob *job = static_cast<ContextJob *>(p_userdata);
+	FidelityFX *api = job->api;
+	Thread::set_name("FSR context preparation");
+	const uint64_t started = OS::get_singleton()->get_ticks_usec();
+	ffxCreateBackendVKDesc backend = {};
+	backend.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+	backend.deviceContext = api->vk->device_context;
+	ffxOverrideVersion version = {};
+	version.header.type = FFX_API_DESC_TYPE_OVERRIDE_VERSION;
+	version.versionId = (job->fg ? api->fg_ids : api->sr_ids)[job->version - 3];
+	if (job->fg) {
+		ffxCreateContextDescFrameGenerationVersion api_version = {};
+		api_version.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION_VERSION, &version.header };
+		api_version.version = FFX_FRAMEGENERATION_VERSION;
+		ffxCreateContextDescFrameGenerationHudless hudless = {};
+		hudless.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION_HUDLESS, &api_version.header };
+		hudless.hudlessBackBufferFormat = job->hudless_format;
+		backend.header.pNext = &hudless.header;
+		ffxCreateContextDescFrameGeneration desc = {};
+		desc.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION, &backend.header };
+		desc.flags = FFX_FRAMEGENERATION_ENABLE_DEPTH_INVERTED;
+		desc.displaySize = { (uint32_t)job->target_size.x, (uint32_t)job->target_size.y };
+		desc.maxRenderSize = { (uint32_t)job->render_size.x, (uint32_t)job->render_size.y };
+		desc.backBufferFormat = job->back_buffer_format;
+		job->result = api->create(&job->context, &desc.header, nullptr);
+		api->fg_create_usec.set(OS::get_singleton()->get_ticks_usec() - started);
+		api->fg_context_creations.increment();
+	} else {
+		ffxCreateContextDescUpscaleVersion api_version = {};
+		api_version.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE_VERSION, &version.header };
+		api_version.version = FFX_UPSCALER_VERSION;
+		backend.header.pNext = &api_version.header;
+		ffxCreateContextDescUpscale desc = {};
+		desc.header = { FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE, &backend.header };
+		desc.flags = FFX_UPSCALE_ENABLE_HIGH_DYNAMIC_RANGE | FFX_UPSCALE_ENABLE_DEPTH_INVERTED | FFX_UPSCALE_ENABLE_AUTO_EXPOSURE;
+		desc.maxRenderSize = { (uint32_t)job->render_size.x, (uint32_t)job->render_size.y };
+		desc.maxUpscaleSize = { (uint32_t)job->target_size.x, (uint32_t)job->target_size.y };
+		job->result = api->create(&job->context, &desc.header, nullptr);
+		api->sr_create_usec.set(OS::get_singleton()->get_ticks_usec() - started);
+		api->sr_context_creations.increment();
+	}
+	api->initializing_effect.set(0);
+	job->done.set(1); // Publish the context/result only after creation is complete.
+}
+
+ffxContext FidelityFX::request_context(bool p_fg, int p_version, Size2i p_render, Size2i p_target, uint32_t p_hudless_format) {
+	if (context_job) {
+		if (!context_job->done.get()) {
+			return nullptr;
+		}
+		context_job->thread.wait_to_finish();
+		const bool matches = context_job->fg == p_fg && context_job->version == p_version &&
+				context_job->render_size == p_render && context_job->target_size == p_target && context_job->hudless_format == p_hudless_format &&
+				(!p_fg || context_job->back_buffer_format == swap_format);
+		if (matches) {
+			const bool ok = check(context_job->result, p_fg);
+			ffxContext result = ok ? context_job->context : nullptr;
+			if (!ok && context_job->context) {
+				destroy(&context_job->context, nullptr);
+			}
+			memdelete(context_job);
+			context_job = nullptr;
+			return result;
+		}
+		// An unused context has never been submitted to the GPU or configured
+		// on the swapchain. Discard stale size/version requests without a stall.
+		finish_context_job();
+	}
+	context_job = memnew(ContextJob);
+	context_job->api = this;
+	context_job->fg = p_fg;
+	context_job->version = p_version;
+	context_job->render_size = p_render;
+	context_job->target_size = p_target;
+	context_job->hudless_format = p_hudless_format;
+	context_job->back_buffer_format = swap_format;
+	initializing_effect.set(p_fg ? 2 : 1);
+	Thread::Settings settings;
+	settings.priority = Thread::PRIORITY_LOW;
+	context_job->thread.start(create_context_worker, context_job, settings);
+	return nullptr;
+}
+
+void FidelityFX::finish_context_job() {
+	if (!context_job) {
+		return;
+	}
+	if (context_job->thread.is_started()) {
+		context_job->thread.wait_to_finish();
+	}
+	if (context_job->context) {
+		destroy(&context_job->context, nullptr);
+	}
+	memdelete(context_job);
+	context_job = nullptr;
+	initializing_effect.set(0);
+}
+
+bool FidelityFX::check(ffxReturnCode_t p_code, bool p_fg) {
+	if (p_code == FFX_API_RETURN_OK) {
+		return true;
+	}
+	last_error.set(p_code);
+	(p_fg ? fg_failed : sr_failed).set(1);
+	WARN_PRINT(vformat("FidelityFX %s disabled after SDK error %d.", p_fg ? "frame generation" : "upscaling", p_code));
+	return false;
+}
+
+void FidelityFX::record_provider(ffxContext *p_context, bool p_fg) {
+	ffxQueryGetProviderVersion q = {};
+	q.header.type = FFX_API_QUERY_DESC_TYPE_GET_PROVIDER_VERSION;
+	if (query(p_context, &q.header) == FFX_API_RETURN_OK && q.versionName) {
+		MutexLock lock(status_mutex);
+		(p_fg ? fg_provider : sr_provider) = String::utf8(q.versionName);
+	}
+}
+
+void FidelityFX::disable_frame_generation() {
+	if (fg_context && fg_config.frameGenerationEnabled) {
+		fg_config.frameGenerationEnabled = false;
+		check(configure(&fg_context, &fg_config.header), true);
+	}
+	fg_active.set(0);
+	prepared = false;
+}
+
+void FidelityFX::wait_for_presents() {
+	if (!swap_context) {
+		return;
+	}
+	ffxDispatchDescFrameGenerationSwapChainWaitForPresentsVK wait = {};
+	wait.header.type = FFX_API_DISPATCH_DESC_TYPE_FGSWAPCHAIN_WAIT_FOR_PRESENTS_VK;
+	check(dispatch(&swap_context, &wait.header), true);
+}
+
+void FidelityFX::release_frame_generation() {
+	MutexLock lock(fg_mutex);
+	disable_frame_generation();
+	wait_for_presents();
+	if (fg_context) {
+		destroy(&fg_context, nullptr);
+		fg_context = nullptr;
+	}
+	active_fg_version = 0;
+}
+
+bool FidelityFX::ensure_frame_generation(Size2i p_render, Size2i p_target, uint32_t p_hudless_format) {
+	const int version = fg_version.get();
+	if (!swap_chain || fg_failed.get() || version < 3 || version > 4 || !fg_supported[version - 3]) {
+		return false;
+	}
+	if (swap_width != (uint32_t)p_target.x || swap_height != (uint32_t)p_target.y) {
+		return false;
+	}
+	// Reserve at least display resolution, so ordinary quality changes can
+	// reuse the same context, including switching upscaling off entirely.
+	p_render = p_render.max(p_target);
+	if (fg_context && (active_fg_version != version || fg_desc.displaySize.width != (uint32_t)p_target.x || fg_desc.displaySize.height != (uint32_t)p_target.y ||
+								fg_desc.maxRenderSize.width != (uint32_t)p_render.x || fg_desc.maxRenderSize.height != (uint32_t)p_render.y ||
+								fg_desc.backBufferFormat != swap_format)) {
+		disable_frame_generation();
+		wait_for_presents();
+		destroy(&fg_context, nullptr);
+		fg_context = nullptr;
+	}
+	if (fg_context) {
+		return true;
+	}
+	// The worker owns a separate, unconfigured context. Present cannot touch
+	// it until this render-thread handoff under fg_mutex.
+	fg_context = request_context(true, version, p_render, p_target, p_hudless_format);
+	if (!fg_context) {
+		return false;
+	}
+	fg_desc.displaySize = { (uint32_t)p_target.x, (uint32_t)p_target.y };
+	fg_desc.maxRenderSize = { (uint32_t)p_render.x, (uint32_t)p_render.y };
+	fg_desc.backBufferFormat = swap_format;
+	active_fg_version = version;
+	record_provider(&fg_context, true);
+	fg_config = {};
+	fg_config.header.type = FFX_API_CONFIGURE_DESC_TYPE_FRAMEGENERATION;
+	fg_config.swapChain = (void *)(VkSwapchainKHR)swap_chain;
+	fg_config.frameGenerationCallback = generate;
+	fg_config.frameGenerationCallbackUserContext = this;
+	// Interpolation stays on the game queue with the single HUD-less copy.
+	fg_config.allowAsyncWorkloads = false;
+	fg_config.generationRect = { 0, 0, p_target.x, p_target.y };
+	if (debug_frames) {
+		fg_config.flags = FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_TEAR_LINES | FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_RESET_INDICATORS;
+	}
+	return true;
+}
+
+ffxReturnCode_t FidelityFX::generate(ffxDispatchDescFrameGeneration *p_desc, void *p_user) {
+	FidelityFX *self = static_cast<FidelityFX *>(p_user);
+	// The replacement present holds fg_mutex and calls this on the same thread.
+	const ffxReturnCode_t code = self->dispatch(&self->fg_context, &p_desc->header);
+	if (self->check(code, true)) {
+		self->fg_dispatches.increment();
+		self->generated_frames.add(p_desc->numGeneratedFrames);
+	}
+	return code;
+}
+
+#endif // FSR_SDK_ENABLED
