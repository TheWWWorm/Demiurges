+FidelityFX *FidelityFX::singleton = nullptr;
+
+#ifdef FSR_SDK_ENABLED
+
+struct FidelityFX::VulkanState {
+	VkInstance instance = VK_NULL_HANDLE;
+	VkPhysicalDevice physical_device = VK_NULL_HANDLE;
+	VkDevice device = VK_NULL_HANDLE;
+	VkDeviceContext device_context = {};
+	// Frame generation needs four distinct queues; Godot's main queue is the game queue.
+	VkQueueInfoFFXAPI game_queue = {};
+	VkQueueInfoFFXAPI async_compute_queue = {};
+	VkQueueInfoFFXAPI present_queue = {};
+	VkQueueInfoFFXAPI image_acquire_queue = {};
+	bool queues_ready = false;
+	GraphicsSDKVulkanProvider::SwapchainFunctions loader;
+	ffxQueryDescSwapchainReplacementFunctionsVK replacement = {};
+	VkPhysicalDeviceSubgroupSizeControlFeatures subgroup_size_control = {};
+	VkPhysicalDeviceSynchronization2Features synchronization2 = {};
+};
+
+namespace {
+
+// Presentation owner for frame generation: extra queues, features and the
+// replacement swapchain. Upscaling alone never needs it.
+class FidelityFXVulkanProvider : public GraphicsSDKVulkanProvider {
+public:
+	FidelityFX *api = nullptr;
+
+	virtual const char *get_name() const override { return "amd"; }
+
+	virtual void get_queue_requests(VkPhysicalDevice p_physical_device, LocalVector<QueueRequest> &r_requests) override {
+		// The driver puts each request in the family with the fewest
+		// capabilities that has the flags, after Godot's own queues, so the
+		// async compute and image acquire queues land in the compute-only and
+		// transfer-only families where the GPU has them.
+		QueueRequest present;
+		present.required_flags = VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT; // UI composition and present.
+		r_requests.push_back(present);
+		QueueRequest async_compute;
+		async_compute.required_flags = VK_QUEUE_COMPUTE_BIT;
+		r_requests.push_back(async_compute);
+		QueueRequest image_acquire;
+		image_acquire.required_flags = VK_QUEUE_TRANSFER_BIT;
+		r_requests.push_back(image_acquire);
+	}
+
+	virtual void adjust_device_features(VkPhysicalDevice p_physical_device, VkPhysicalDeviceFeatures2 *r_features2, VkPhysicalDeviceVulkan12Features *r_features12, VkPhysicalDeviceVulkan13Features *r_features13) override {
+		if (r_features2 == nullptr) {
+			return;
+		}
+		// The SDK backend selects wave32 pipelines and synchronization2 from the
+		// device's supported extensions, so enable the matching features.
+		uint32_t count = 0;
+		vkEnumerateDeviceExtensionProperties(p_physical_device, nullptr, &count, nullptr);
+		LocalVector<VkExtensionProperties> extensions;
+		extensions.resize(count);
+		vkEnumerateDeviceExtensionProperties(p_physical_device, nullptr, &count, extensions.ptr());
+		bool has_subgroup_size_control = false;
+		bool has_synchronization2 = false;
+		for (const VkExtensionProperties &extension : extensions) {
+			has_subgroup_size_control |= strcmp(extension.extensionName, VK_EXT_SUBGROUP_SIZE_CONTROL_EXTENSION_NAME) == 0;
+			has_synchronization2 |= strcmp(extension.extensionName, VK_KHR_SYNCHRONIZATION_2_EXTENSION_NAME) == 0;
+		}
+		FidelityFX::VulkanState *vk = api->vk;
+		vk->subgroup_size_control.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_FEATURES;
+		vk->synchronization2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SYNCHRONIZATION_2_FEATURES;
+		vk->subgroup_size_control.pNext = &vk->synchronization2;
+		VkPhysicalDeviceFeatures2 supported = {};
+		supported.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+		supported.pNext = &vk->subgroup_size_control;
+		vkGetPhysicalDeviceFeatures2(p_physical_device, &supported);
+		vk->subgroup_size_control.pNext = nullptr;
+		vk->synchronization2.pNext = nullptr;
+		const bool want_subgroup_size_control = has_subgroup_size_control && vk->subgroup_size_control.subgroupSizeControl;
+		const bool want_synchronization2 = has_synchronization2 && vk->synchronization2.synchronization2;
+		if (r_features13 != nullptr) {
+			// Covered by the core 1.3 struct; the individual structs must not be chained too.
+			r_features13->subgroupSizeControl |= want_subgroup_size_control;
+			r_features13->synchronization2 |= want_synchronization2;
+			return;
+		}
+		// Reuse structs already in the chain; prepend ours otherwise.
+		for (VkBaseOutStructure *s = (VkBaseOutStructure *)r_features2->pNext; s != nullptr; s = s->pNext) {
+			if (s->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_FEATURES && want_subgroup_size_control) {
+				((VkPhysicalDeviceSubgroupSizeControlFeatures *)s)->subgroupSizeControl = VK_TRUE;
+				vk->subgroup_size_control.subgroupSizeControl = VK_FALSE;
+			} else if (s->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SYNCHRONIZATION_2_FEATURES && want_synchronization2) {
+				((VkPhysicalDeviceSynchronization2Features *)s)->synchronization2 = VK_TRUE;
+				vk->synchronization2.synchronization2 = VK_FALSE;
+			}
+		}
+		if (want_subgroup_size_control && vk->subgroup_size_control.subgroupSizeControl) {
+			vk->subgroup_size_control.pNext = r_features2->pNext;
+			r_features2->pNext = &vk->subgroup_size_control;
+		}
+		if (want_synchronization2 && vk->synchronization2.synchronization2) {
+			vk->synchronization2.pNext = r_features2->pNext;
+			r_features2->pNext = &vk->synchronization2;
+		}
+	}
+
+	virtual bool device_created(const DeviceInfo &p_info) override {
+		FidelityFX::VulkanState *vk = api->vk;
+		vk->instance = p_info.instance;
+		vk->physical_device = p_info.physical_device;
+		vk->device = p_info.device;
+		vk->device_context.vkDevice = p_info.device;
+		vk->device_context.vkPhysicalDevice = p_info.physical_device;
+		vk->device_context.vkDeviceProcAddr = p_info.get_device_proc_addr ? p_info.get_device_proc_addr : vkGetDeviceProcAddr;
+		vk->game_queue = { p_info.graphics_queue, p_info.graphics_queue_family, nullptr };
+		VkQueueInfoFFXAPI *targets[3] = { &vk->present_queue, &vk->async_compute_queue, &vk->image_acquire_queue };
+		vk->queues_ready = p_info.graphics_queue != VK_NULL_HANDLE && p_info.extra_queues.size() == 3;
+		for (uint32_t i = 0; i < p_info.extra_queues.size() && i < 3; i++) {
+			const QueueRequest &request = p_info.extra_queues[i];
+			if (request.family_index == UINT32_MAX) {
+				vk->queues_ready = false;
+				continue;
+			}
+			VkQueue queue = VK_NULL_HANDLE;
+			vkGetDeviceQueue(p_info.device, request.family_index, request.first_queue_index, &queue);
+			*targets[i] = { queue, request.family_index, nullptr };
+			vk->queues_ready = vk->queues_ready && queue != VK_NULL_HANDLE;
+		}
+		print_verbose(vformat("FidelityFX: game queue family %d, present %d, async compute %d, image acquire %d.", vk->game_queue.familyIndex, vk->present_queue.familyIndex, vk->async_compute_queue.familyIndex, vk->image_acquire_queue.familyIndex));
+		api->device_ready = true;
+		api->query_versions();
+		return true;
+	}
+
+	virtual void device_destroying() override {
+		api->shutdown_device();
+	}
+
+	virtual void get_swapchain_functions(SwapchainFunctions &r_functions) override;
+};
+
+FidelityFXVulkanProvider vulkan_provider;
+
+FidelityFX::VulkanState *vk_state() {
+	return FidelityFX::get_singleton()->vk;
+}
+
+bool is_frame_generation_swapchain(VkSwapchainKHR p_swapchain) {
+	FidelityFX *api = FidelityFX::get_singleton();
+	return p_swapchain != VK_NULL_HANDLE && api->swap_chain != 0 && (uint64_t)p_swapchain == api->swap_chain;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL fsr_create_swapchain(VkDevice p_device, const VkSwapchainCreateInfoKHR *p_info, const VkAllocationCallbacks *p_allocator, VkSwapchainKHR *r_swapchain) {
+	FidelityFX *api = FidelityFX::get_singleton();
+	FidelityFX::VulkanState *vk = api->vk;
+	const bool fg_possible = api->presentation_owner && api->device_ready && vk->queues_ready && (api->fg_supported[0] || api->fg_supported[1]);
+	if (!fg_possible || api->swap_chain != 0 || p_info->oldSwapchain != VK_NULL_HANDLE) {
+		return vk->loader.create_swapchain(p_device, p_info, p_allocator, r_swapchain);
+	}
+
+	ffxCreateContextDescFrameGenerationSwapChainVersionVK version = {};
+	version.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATIONSWAPCHAIN_VERSION_VK;
+	version.version = FFX_FRAMEGENERATION_SWAPCHAIN_VK_VERSION;
+	VkSwapchainKHR swapchain = VK_NULL_HANDLE;
+	ffxCreateContextDescFrameGenerationSwapChainVK desc = {};
+	desc.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FGSWAPCHAIN_VK;
+	desc.header.pNext = &version.header;
+	desc.physicalDevice = vk->physical_device;
+	desc.device = p_device;
+	desc.swapchain = &swapchain;
+	desc.allocator = nullptr;
+	desc.createInfo = *p_info;
+	desc.gameQueue = vk->game_queue;
+	desc.asyncComputeQueue = vk->async_compute_queue;
+	desc.presentQueue = vk->present_queue;
+	desc.imageAcquireQueue = vk->image_acquire_queue;
+
+	ffxContext context = nullptr;
+	ffxReturnCode_t code = api->create(&context, &desc.header, nullptr);
+	if (code != FFX_API_RETURN_OK || swapchain == VK_NULL_HANDLE) {
+		api->swap_reason = vformat("frame generation swapchain creation failed (SDK error %d)", code);
+		WARN_PRINT("FidelityFX: " + api->swap_reason + "; presenting without frame generation.");
+		if (context) {
+			api->destroy(&context, nullptr);
+		}
+		api->fg_failed.set(1);
+		return vk->loader.create_swapchain(p_device, p_info, p_allocator, r_swapchain);
+	}
+
+	ffxQueryDescSwapchainReplacementFunctionsVK replacement = {};
+	replacement.header.type = FFX_API_QUERY_DESC_TYPE_FGSWAPCHAIN_FUNCTIONS_VK;
+	code = api->query(&context, &replacement.header);
+	if (code != FFX_API_RETURN_OK || !replacement.pOutQueuePresentKHR || !replacement.pOutAcquireNextImageKHR || !replacement.pOutGetSwapchainImagesKHR || !replacement.pOutDestroySwapchainFFXAPI) {
+		// The replacement swapchain cannot be used or destroyed without these.
+		api->destroy(&context, nullptr);
+		api->swap_reason = vformat("swapchain replacement functions unavailable (SDK error %d)", code);
+		api->fg_failed.set(1);
+		ERR_FAIL_V_MSG(VK_ERROR_INITIALIZATION_FAILED, "FidelityFX: " + api->swap_reason + ".");
+	}
+
+	{
+		MutexLock lock(api->fg_mutex);
+		vk->replacement = replacement;
+		api->swap_context = context;
+		api->swap_chain = (uint64_t)swapchain;
+		api->swap_format = ffxApiGetSurfaceFormatVK(p_info->imageFormat);
+		api->swap_width = p_info->imageExtent.width;
+		api->swap_height = p_info->imageExtent.height;
+		api->last_present_count = 0;
+		api->swap_reason = String();
+	}
+	api->swapchain_creations.increment();
+	ffxQueryGetProviderVersion provider = {};
+	provider.header.type = FFX_API_QUERY_DESC_TYPE_GET_PROVIDER_VERSION;
+	if (api->query(&api->swap_context, &provider.header) == FFX_API_RETURN_OK && provider.versionName) {
+		api->swap_provider = String::utf8(provider.versionName);
+	}
+	print_verbose(vformat("FidelityFX: frame generation swapchain %dx%d (%s).", api->swap_width, api->swap_height, api->swap_provider));
+	*r_swapchain = swapchain;
+	return VK_SUCCESS;
+}
+
+VKAPI_ATTR void VKAPI_CALL fsr_destroy_swapchain(VkDevice p_device, VkSwapchainKHR p_swapchain, const VkAllocationCallbacks *p_allocator) {
+	FidelityFX *api = FidelityFX::get_singleton();
+	FidelityFX::VulkanState *vk = api->vk;
+	if (!is_frame_generation_swapchain(p_swapchain)) {
+		vk->loader.destroy_swapchain(p_device, p_swapchain, p_allocator);
+		return;
+	}
+	// The frame generation context references the swapchain; release it first,
+	// then let in-flight presents finish before the swapchain context goes.
+	api->release_frame_generation();
+	MutexLock lock(api->fg_mutex);
+	api->wait_for_presents();
+	if (api->swap_context) {
+		api->destroy(&api->swap_context, nullptr);
+		api->swap_context = nullptr;
+	}
+	api->swap_chain = 0;
+	vk->replacement.pOutDestroySwapchainFFXAPI(p_device, p_swapchain, p_allocator, nullptr);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL fsr_get_swapchain_images(VkDevice p_device, VkSwapchainKHR p_swapchain, uint32_t *r_count, VkImage *r_images) {
+	FidelityFX::VulkanState *vk = vk_state();
+	if (is_frame_generation_swapchain(p_swapchain)) {
+		return vk->replacement.pOutGetSwapchainImagesKHR(p_device, p_swapchain, r_count, r_images);
+	}
+	return vk->loader.get_swapchain_images(p_device, p_swapchain, r_count, r_images);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL fsr_acquire_next_image(VkDevice p_device, VkSwapchainKHR p_swapchain, uint64_t p_timeout, VkSemaphore p_semaphore, VkFence p_fence, uint32_t *r_index) {
+	FidelityFX::VulkanState *vk = vk_state();
+	if (is_frame_generation_swapchain(p_swapchain)) {
+		return vk->replacement.pOutAcquireNextImageKHR(p_device, p_swapchain, p_timeout, p_semaphore, p_fence, r_index);
+	}
+	return vk->loader.acquire_next_image(p_device, p_swapchain, p_timeout, p_semaphore, p_fence, r_index);
+}
+
+VkResult present_frame_generation(VkQueue p_queue, const VkPresentInfoKHR *p_info) {
+	FidelityFX *api = FidelityFX::get_singleton();
+	FidelityFX::VulkanState *vk = api->vk;
+	MutexLock lock(api->fg_mutex);
+	if (!api->prepared || !api->fg_version.get() || api->fg_failed.get()) {
+		api->disable_frame_generation();
+	}
+	// The SDK records the interpolation workload through generate() on this
+	// thread, inside the replacement present.
+	VkResult result = vk->replacement.pOutQueuePresentKHR(p_queue, p_info);
+	if (result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR) {
+		api->game_presents.increment();
+	}
+	if (vk->replacement.pOutGetLastPresentCountFFXAPI) {
+		// Counts presents of the real swapchain, generated frames included.
+		const uint64_t count = vk->replacement.pOutGetLastPresentCountFFXAPI((VkSwapchainKHR)api->swap_chain);
+		api->present_count_available.set(1);
+		if (count >= api->last_present_count) {
+			api->presented_frames.add(count - api->last_present_count);
+		}
+		api->last_present_count = count;
+	}
+	api->prepared = false;
+	api->frame_id++;
+	return result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL fsr_queue_present(VkQueue p_queue, const VkPresentInfoKHR *p_info) {
+	FidelityFX::VulkanState *vk = vk_state();
+	int32_t fg_index = -1;
+	for (uint32_t i = 0; i < p_info->swapchainCount; i++) {
+		if (is_frame_generation_swapchain(p_info->pSwapchains[i])) {
+			fg_index = i;
+		}
+	}
+	if (fg_index < 0) {
+		return vk->loader.queue_present(p_queue, p_info);
+	}
+	if (p_info->swapchainCount == 1) {
+		return present_frame_generation(p_queue, p_info);
+	}
+
+	// Several windows: Godot signals one semaphore per swapchain, in order.
+	const bool per_swapchain_semaphores = p_info->waitSemaphoreCount == p_info->swapchainCount;
+	LocalVector<VkSwapchainKHR> other_swapchains;
+	LocalVector<uint32_t> other_indices;
+	LocalVector<VkSemaphore> other_semaphores;
+	LocalVector<VkResult> other_results;
+	for (uint32_t i = 0; i < p_info->swapchainCount; i++) {
+		if ((int32_t)i == fg_index) {
+			continue;
+		}
+		other_swapchains.push_back(p_info->pSwapchains[i]);
+		other_indices.push_back(p_info->pImageIndices[i]);
+		if (per_swapchain_semaphores) {
+			other_semaphores.push_back(p_info->pWaitSemaphores[i]);
+		}
+	}
+	VkPresentInfoKHR fg_info = *p_info;
+	VkResult fg_result = VK_SUCCESS;
+	fg_info.swapchainCount = 1;
+	fg_info.pSwapchains = &p_info->pSwapchains[fg_index];
+	fg_info.pImageIndices = &p_info->pImageIndices[fg_index];
+	fg_info.pResults = &fg_result;
+	if (per_swapchain_semaphores) {
+		fg_info.waitSemaphoreCount = 1;
+		fg_info.pWaitSemaphores = &p_info->pWaitSemaphores[fg_index];
+	}
+	VkResult result = present_frame_generation(p_queue, &fg_info);
+
+	other_results.resize(other_swapchains.size());
+	VkPresentInfoKHR other_info = *p_info;
+	other_info.swapchainCount = other_swapchains.size();
+	other_info.pSwapchains = other_swapchains.ptr();
+	other_info.pImageIndices = other_indices.ptr();
+	other_info.pResults = other_results.ptr();
+	other_info.waitSemaphoreCount = other_semaphores.size();
+	other_info.pWaitSemaphores = other_semaphores.ptr();
+	VkResult other_result = vk->loader.queue_present(p_queue, &other_info);
+
+	if (p_info->pResults) {
+		uint32_t other = 0;
+		for (uint32_t i = 0; i < p_info->swapchainCount; i++) {
+			p_info->pResults[i] = (int32_t)i == fg_index ? fg_result : other_results[other++];
+		}
+	}
+	return result != VK_SUCCESS ? result : other_result;
+}
+
+void FidelityFXVulkanProvider::get_swapchain_functions(SwapchainFunctions &r_functions) {
+	api->vk->loader = r_functions;
+	r_functions.create_swapchain = fsr_create_swapchain;
+	r_functions.destroy_swapchain = fsr_destroy_swapchain;
+	r_functions.get_swapchain_images = fsr_get_swapchain_images;
+	r_functions.acquire_next_image = fsr_acquire_next_image;
+	r_functions.queue_present = fsr_queue_present;
+}
+
+// Reads "3.1.6" or "FSR 4.0.2" style provider names.
+bool parse_provider_version(const String &p_name, int &r_major, int &r_minor) {
+	int i = 0;
+	while (i < p_name.length() && !is_digit(p_name[i])) {
+		i++;
+	}
+	const PackedStringArray parts = p_name.substr(i).split(".");
+	if (parts.size() < 2 || !parts[0].is_valid_int() || !parts[1].get_slicec(' ', 0).is_valid_int()) {
+		return false;
+	}
+	r_major = parts[0].to_int();
+	r_minor = parts[1].get_slicec(' ', 0).to_int();
+	return true;
+}
