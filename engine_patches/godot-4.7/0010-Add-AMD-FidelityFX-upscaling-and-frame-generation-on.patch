+
+Dictionary FidelityFX::get_status() const {
+	MutexLock lock(status_mutex);
+	Dictionary d;
+	d["compiled"] = false;
+	d["initialized"] = false;
+	d["sr3_supported"] = false;
+	d["sr4_supported"] = false;
+	d["fg3_supported"] = false;
+	d["fg4_supported"] = false;
+#ifdef FSR_SDK_ENABLED
+	d["compiled"] = true;
+	d["backend"] = "vulkan";
+	d["sdk_version"] = FSR_SDK_PINNED_VERSION;
+	d["initialized"] = device_ready;
+	d["runtime_loaded"] = runtime_loaded;
+	d["runtime_reason"] = runtime_reason;
+	d["requested_owner"] = GraphicsSDKVulkan::get_requested_owner();
+	d["presentation_owner"] = presentation_owner;
+	d["presentation_owner_reason"] = owner_reason;
+	d["sr3_supported"] = sr_supported[0] && !sr_failed.get();
+	d["sr4_supported"] = sr_supported[1] && !sr_failed.get();
+	d["fg3_supported"] = fg_supported[0] && swap_chain != 0 && !fg_failed.get();
+	d["fg4_supported"] = fg_supported[1] && swap_chain != 0 && !fg_failed.get();
+	const String failed_sr = vformat("upscaling disabled after SDK error %d", last_error.get());
+	const String failed_fg = vformat("frame generation disabled after SDK error %d", last_error.get());
+	for (int i = 0; i < 2; i++) {
+		String sr = sr_supported[i] ? String() : sr_reason[i];
+		if (sr_supported[i] && sr_failed.get()) {
+			sr = failed_sr;
+		}
+		String fg = fg_supported[i] ? String() : fg_reason[i];
+		if (fg_supported[i] && fg_failed.get()) {
+			fg = swap_reason.is_empty() ? failed_fg : swap_reason;
+		} else if (fg_supported[i] && swap_chain == 0) {
+			fg = swap_reason.is_empty() ? String("no frame generation swapchain yet") : swap_reason;
+		}
+		d[i == 0 ? "sr3_reason" : "sr4_reason"] = sr;
+		d[i == 0 ? "fg3_reason" : "fg4_reason"] = fg;
+	}
+	d["upscaler_versions"] = sr_versions_found;
+	d["frame_generation_versions"] = fg_versions_found;
+	d["swapchain_versions"] = swapchain_versions_found;
+	d["upscaler_version_requested"] = (int64_t)sr_version.get();
+	d["frame_generation_version_requested"] = (int64_t)fg_version.get();
+	d["upscaler_provider"] = sr_provider;
+	d["frame_generation_provider"] = fg_provider;
+	// Some runtimes do not answer the provider query for the swapchain context;
+	// report the first listed swapchain version then.
+	String swapchain_provider = swap_provider;
+	if (swapchain_provider.is_empty() && swap_chain != 0) {
+		swapchain_provider = swapchain_versions_found.get_slicec(',', 0).strip_edges();
+	}
+	d["swapchain_provider"] = swapchain_provider;
+	d["swapchain_active"] = swap_chain != 0;
+	d["swapchain_creations"] = (int64_t)swapchain_creations.get();
+	d["upscale_evaluations"] = (int64_t)sr_evaluations.get();
+	d["frame_generation_dispatches"] = (int64_t)fg_dispatches.get();
+	d["generated_frames"] = (int64_t)generated_frames.get();
+	d["game_presents"] = (int64_t)game_presents.get();
+	d["presented_frames"] = (int64_t)presented_frames.get();
+	d["present_count_available"] = present_count_available.get() != 0;
+	d["frame_generation_active"] = fg_active.get() != 0;
+	d["last_error"] = last_error.get();
+	d["temporal_shaders_initializing"] = temporal_shaders_initializing.get() != 0;
+	d["upscaler_initializing"] = initializing_effect.get() == 1;
+	d["frame_generation_initializing"] = initializing_effect.get() == 2;
+	d["upscaler_create_ms"] = sr_create_usec.get() / 1000.0;
+	d["upscaler_max_dispatch_ms"] = sr_max_dispatch_usec.get() / 1000.0;
+	d["prepare_max_ms"] = prepare_max_usec.get() / 1000.0;
+	d["frame_generation_create_ms"] = fg_create_usec.get() / 1000.0;
+	d["upscaler_context_creations"] = (int64_t)sr_context_creations.get();
+	d["frame_generation_context_creations"] = (int64_t)fg_context_creations.get();
+	// Vulkan has no frame latency waitable object: with frame generation the
+	// game should cap its own rate slightly below half the display refresh.
+	d["frame_latency_waitable"] = false;
+	int64_t recommended_max_fps = 0;
+	if (fg_active.get() && DisplayServer::get_singleton()) {
+		const float refresh = DisplayServer::get_singleton()->screen_get_refresh_rate();
+		if (refresh > 0.0f) {
+			recommended_max_fps = MAX(int64_t(1), int64_t(refresh * 0.5f) - 1);
+		}
+	}
+	d["recommended_max_fps"] = recommended_max_fps;
+#endif
+	return d;
+}
