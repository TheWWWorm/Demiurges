+#include "fsr_sdk.h"
+
+#include "../uniform_set_cache_rd.h"
+#include "core/os/os.h"
+#include "drivers/fsr_sdk/fsr_sdk.h"
+
+using namespace RendererRD;
+
+#ifdef FSR_SDK_ENABLED
+
+namespace RendererRD {
+
+class FSRSDKContextVulkan : public FSRSDKContext {
+public:
+	ffxContext sr = nullptr;
+	int version = 3;
+	Size2i target_size;
+	RID reactive;
+	RID hudless;
+	bool first = true;
+	bool evaluated = false;
+
+	~FSRSDKContextVulkan() {
+		FidelityFX *api = FidelityFX::get_singleton();
+		RD::get_singleton()->_flush_and_stall_for_all_frames();
+		api->release_frame_generation();
+		if (sr) {
+			api->destroy(&sr, nullptr);
+		}
+		if (reactive.is_valid()) {
+			RD::get_singleton()->free_rid(reactive);
+		}
+		if (hudless.is_valid()) {
+			RD::get_singleton()->free_rid(hudless);
+		}
+	}
+};
+
+} // namespace RendererRD
+
+// Read-only inputs are handed over by the render graph in
+// SHADER_READ_ONLY_OPTIMAL (SDK state COMPUTE_READ); written images in GENERAL
+// (SDK state UNORDERED_ACCESS). The SDK returns each image to that state.
+static void add_callback_resource(LocalVector<RD::CallbackResource> &r_resources, RID p_texture, bool p_write) {
+	RD::CallbackResource resource;
+	resource.rid = p_texture;
+	resource.usage = p_write ? RD::CALLBACK_RESOURCE_USAGE_STORAGE_IMAGE_READ_WRITE : RD::CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE;
+	r_resources.push_back(resource);
+}
+
+static FfxApiResource input_resource(RID p_texture, uint32_t p_usage = 0) {
+	return FidelityFX::get_singleton()->get_resource(p_texture, FFX_API_RESOURCE_STATE_COMPUTE_READ, p_usage);
+}
+
+FSRSDKEffect::FSRSDKEffect() {
+	Vector<String> modes;
+	modes.push_back("\n");
+	shader.initialize(modes, "");
+	shader_version = shader.version_create();
+	pipeline = RD::get_singleton()->compute_pipeline_create(shader.version_get_shader(shader_version, 0));
+	FidelityFX::get_singleton()->initialize_from_rendering_device();
+}
+
+FSRSDKEffect::~FSRSDKEffect() {
+	shader.version_free(shader_version);
+}
+
+bool FSRSDKEffect::is_version_current(FSRSDKContext *p_context, bool p_upscaling) const {
+	const int version = p_upscaling ? FidelityFX::get_singleton()->get_upscaler_version() : 0;
+	return p_context && static_cast<FSRSDKContextVulkan *>(p_context)->version == version;
+}
+
+FSRSDKContext *FSRSDKEffect::create_context(Size2i p_internal, Size2i p_target, bool p_upscaling) {
+	FidelityFX *api = FidelityFX::get_singleton();
+	const int version = p_upscaling ? api->get_upscaler_version() : 0;
+	ffxContext sr = nullptr;
+	if (p_upscaling) {
+		if (!api->sr_available()) {
+			return nullptr;
+		}
+		sr = api->request_context(false, version, p_internal, p_target);
+		if (!sr) {
+			return nullptr;
+		}
+		api->record_provider(&sr, false);
+	}
+	FSRSDKContextVulkan *ctx = memnew(FSRSDKContextVulkan);
+	ctx->sr = sr;
+	ctx->version = version;
+	ctx->target_size = p_target;
+	RD::TextureFormat format;
+	format.format = RD::DATA_FORMAT_R8_UNORM;
+	format.width = p_internal.x;
+	format.height = p_internal.y;
+	format.usage_bits = RD::TEXTURE_USAGE_STORAGE_BIT | RD::TEXTURE_USAGE_SAMPLING_BIT;
+	ctx->reactive = RD::get_singleton()->texture_create(format, RD::TextureView());
+	return ctx;
+}
+
+void FSRSDKEffect::process(const FSRSDKContext::Parameters &p_params) {
+	FSRSDKContextVulkan *ctx = static_cast<FSRSDKContextVulkan *>(p_params.context);
+	FidelityFX *api = FidelityFX::get_singleton();
+	if (!ctx || (ctx->sr && !api->sr_available())) {
+		return;
+	}
+	const uint64_t started = OS::get_singleton()->get_ticks_usec();
+	ctx->last_parameters = p_params;
+	ctx->evaluated = false;
+	RD *rd = RD::get_singleton();
+	UniformSetCacheRD *cache = UniformSetCacheRD::get_singleton();
+	RID shader_rid = shader.version_get_shader(shader_version, 0);
+	RD::ComputeListID list = rd->compute_list_begin();
+	rd->compute_list_bind_compute_pipeline(list, pipeline);
+	RD::Uniform uniforms[] = {
+		RD::Uniform(RD::UNIFORM_TYPE_IMAGE, 0, p_params.velocity),
+		RD::Uniform(RD::UNIFORM_TYPE_TEXTURE, 0, p_params.depth),
+		RD::Uniform(RD::UNIFORM_TYPE_TEXTURE, 0, p_params.color),
+		RD::Uniform(RD::UNIFORM_TYPE_IMAGE, 0, ctx->reactive),
+	};
+	for (int i = 0; i < 4; i++) {
+		rd->compute_list_bind_uniform_set(list, cache->get_cache(shader_rid, i, uniforms[i]), i);
+	}
+	float constants[20] = {};
+	constants[0] = p_params.internal_size.x;
+	constants[1] = p_params.internal_size.y;
+	memcpy(constants + 4, &p_params.reprojection.columns[0].x, sizeof(float) * 16);
+	rd->compute_list_set_push_constant(list, constants, sizeof(constants));
+	rd->compute_list_dispatch_threads(list, p_params.internal_size.x, p_params.internal_size.y, 1);
+	rd->compute_list_end();
+	api->prepare_max_usec.set(MAX(api->prepare_max_usec.get(), OS::get_singleton()->get_ticks_usec() - started));
+	if (!ctx->sr) {
+		ctx->evaluated = true;
+		return;
+	}
+	LocalVector<RD::CallbackResource> resources;
+	add_callback_resource(resources, p_params.color, false);
+	add_callback_resource(resources, p_params.depth, false);
+	add_callback_resource(resources, p_params.velocity, false);
+	add_callback_resource(resources, ctx->reactive, false);
+	add_callback_resource(resources, p_params.output, true);
+	rd->driver_callback_add(upscale_callback, ctx, VectorView<RD::CallbackResource>(resources.ptr(), resources.size()));
+}
+
+void FSRSDKEffect::upscale_callback(RenderingDeviceDriver *p_driver, RenderingDeviceDriver::CommandBufferID p_commands, void *p_userdata) {
+	FSRSDKContextVulkan *ctx = static_cast<FSRSDKContextVulkan *>(p_userdata);
+	FidelityFX *api = FidelityFX::get_singleton();
+	const FSRSDKContext::Parameters &p = ctx->last_parameters;
+	ffxDispatchDescUpscale d = {};
+	d.header.type = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+	d.commandList = p_driver->command_buffer_get_native_handle(p_commands);
+	if (!d.commandList) {
+		return;
+	}
+	d.color = input_resource(p.color);
+	d.depth = input_resource(p.depth, FFX_API_RESOURCE_USAGE_DEPTHTARGET);
+	d.motionVectors = input_resource(p.velocity);
+	d.reactive = input_resource(ctx->reactive);
+	d.output = api->get_resource(p.output, FFX_API_RESOURCE_STATE_UNORDERED_ACCESS);
+	d.jitterOffset = { (float)p.jitter.x, (float)p.jitter.y };
+	d.motionVectorScale = { (float)p.internal_size.x, (float)p.internal_size.y };
+	d.renderSize = { (uint32_t)p.internal_size.x, (uint32_t)p.internal_size.y };
+	d.upscaleSize = { (uint32_t)ctx->target_size.x, (uint32_t)ctx->target_size.y };
+	d.frameTimeDelta = MAX(p.delta_time * 1000.0f, 0.1f);
+	d.preExposure = 1.0f;
+	d.reset = ctx->first || p.reset_accumulation;
+	d.cameraNear = p.z_near;
+	d.cameraFar = p.z_far;
+	d.cameraFovAngleVertical = Math::deg_to_rad(p.fovy);
+	d.viewSpaceToMetersFactor = 1.0f;
+	d.enableSharpening = true;
+	d.sharpness = p.sharpness;
+	const uint64_t started = OS::get_singleton()->get_ticks_usec();
+	const bool ok = api->check(api->dispatch(&ctx->sr, &d.header));
+	api->sr_max_dispatch_usec.set(MAX(api->sr_max_dispatch_usec.get(), OS::get_singleton()->get_ticks_usec() - started));
+	if (ok) {
+		ctx->evaluated = true;
+		api->sr_evaluations.increment();
+		ctx->first = false;
+	}
+}
+
+void FSRSDKEffect::prepare_frame_generation(FSRSDKContext *p_context, RID p_color) {
+	FSRSDKContextVulkan *ctx = static_cast<FSRSDKContextVulkan *>(p_context);
+	if (!ctx || !ctx->last_parameters.frame_generation) {
+		return;
+	}
+	RD *rd = RD::get_singleton();
+	RD::TextureFormat format = rd->texture_get_format(p_color);
+	if (ctx->hudless.is_valid()) {
+		const RD::TextureFormat current = rd->texture_get_format(ctx->hudless);
+		if (current.width != format.width || current.height != format.height || current.format != format.format) {
+			rd->free_rid(ctx->hudless);
+			ctx->hudless = RID();
+		}
+	}
+	if (!ctx->hudless.is_valid()) {
+		format.usage_bits = RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_CAN_COPY_TO_BIT;
+		format.shareable_formats.clear();
+		ctx->hudless = rd->texture_create(format, RD::TextureView());
+	}
+	// HUD-less colour: the tonemapped frame before the 2D interface is drawn.
+	rd->texture_copy(p_color, ctx->hudless, Vector3(), Vector3(), Vector3(format.width, format.height, 1), 0, 0, 0, 0);
+	LocalVector<RD::CallbackResource> resources;
+	add_callback_resource(resources, ctx->hudless, false);
+	add_callback_resource(resources, ctx->last_parameters.depth, false);
+	add_callback_resource(resources, ctx->last_parameters.velocity, false);
+	rd->driver_callback_add(frame_generation_callback, ctx, VectorView<RD::CallbackResource>(resources.ptr(), resources.size()));
+}
+
+void FSRSDKEffect::frame_generation_callback(RenderingDeviceDriver *p_driver, RenderingDeviceDriver::CommandBufferID p_commands, void *p_userdata) {
+	FSRSDKContextVulkan *ctx = static_cast<FSRSDKContextVulkan *>(p_userdata);
+	FidelityFX *api = FidelityFX::get_singleton();
+	if (!ctx->evaluated) {
+		return;
+	}
+	MutexLock lock(api->fg_mutex);
+	// The interpolation reads the HUD-less copy at present time, after this
+	// frame's commands; the render graph leaves it in SHADER_READ_ONLY_OPTIMAL.
+	const FfxApiResource hudless = input_resource(ctx->hudless);
+	if (!api->ensure_frame_generation(ctx->last_parameters.internal_size, ctx->target_size, hudless.description.format)) {
+		return;
+	}
+	const FSRSDKContext::Parameters &p = ctx->last_parameters;
+	// Required order: Configure -> PrepareV2 -> dispatch from the replacement present.
+	api->fg_config.frameGenerationEnabled = true;
+	api->fg_config.frameID = api->frame_id;
+	api->fg_config.HUDLessColor = hudless;
+	if (!api->check(api->configure(&api->fg_context, &api->fg_config.header), true)) {
+		return;
+	}
+	ffxDispatchDescFrameGenerationPrepareV2 d = {};
+	d.header.type = FFX_API_DISPATCH_DESC_TYPE_FRAMEGENERATION_PREPARE_V2;
+	d.commandList = p_driver->command_buffer_get_native_handle(p_commands);
+	if (!d.commandList) {
+		return;
+	}
+	d.depth = input_resource(p.depth, FFX_API_RESOURCE_USAGE_DEPTHTARGET);
+	d.motionVectors = input_resource(p.velocity);
+	d.frameID = api->frame_id;
+	d.flags = api->fg_config.flags;
+	d.jitterOffset = { (float)p.jitter.x, (float)p.jitter.y };
+	d.motionVectorScale = { (float)p.internal_size.x, (float)p.internal_size.y };
+	d.renderSize = { (uint32_t)p.internal_size.x, (uint32_t)p.internal_size.y };
+	d.frameTimeDelta = MAX(p.delta_time * 1000.0f, 0.1f);
+	d.reset = p.reset_accumulation || !api->fg_active.get();
+	d.cameraNear = p.z_near;
+	d.cameraFar = p.z_far;
+	d.cameraFovAngleVertical = Math::deg_to_rad(p.fovy);
+	d.viewSpaceToMetersFactor = 1.0f;
+	const Vector3 pos = p.cam_transform.origin;
+	const Vector3 up = p.cam_transform.basis.get_column(1);
+	const Vector3 right = p.cam_transform.basis.get_column(0);
+	const Vector3 forward = -p.cam_transform.basis.get_column(2);
+	for (int i = 0; i < 3; i++) {
+		d.cameraPosition[i] = pos[i];
+		d.cameraUp[i] = up[i];
+		d.cameraRight[i] = right[i];
+		d.cameraForward[i] = forward[i];
+	}
+	if (api->check(api->dispatch(&api->fg_context, &d.header), true)) {
+		api->prepared = true;
+		api->fg_active.set(1);
+	}
+}
+
+#else
+
+FSRSDKEffect::FSRSDKEffect() {}
+FSRSDKEffect::~FSRSDKEffect() {}
+FSRSDKContext *FSRSDKEffect::create_context(Size2i, Size2i, bool) {
+	return nullptr;
+}
+bool FSRSDKEffect::is_version_current(FSRSDKContext *, bool) const {
+	return false;
+}
+void FSRSDKEffect::process(const FSRSDKContext::Parameters &) {}
+void FSRSDKEffect::prepare_frame_generation(FSRSDKContext *, RID) {}
+
+#endif
