@@ -68,6 +68,9 @@ if env["sdl"] and env["platform"] in ["linuxbsd", "macos", "windows", "ios", "vi
 # Core dependencies
 SConscript("png/SCsub")
 
+# NVIDIA Streamline (after the Vulkan driver, whose include paths it needs).
