+
+// Streamline on Vulkan with manual hooking (Streamline ProgrammingGuideManualHooking.md):
+// - slInit(eUseManualHooking) runs before vkCreateInstance (Main::setup).
+// - Godot creates the instance and device itself, adding the extensions,
+//   1.2/1.3 features and extra queues reported by slGetFeatureRequirements.
+// - slSetVulkanInfo then gives Streamline the handles and its queue indices.
+// - Only the hooked entry points (swapchain, present, acquire, device idle,
+//   Win32 surface) go through the proxies exported by sl.interposer.dll.
+class StreamlineVulkanProvider : public GraphicsSDKVulkanProvider {
+	enum {
+		FEATURE_DLSS = 0,
+		FEATURE_DLSS_RR = 1,
+		FEATURE_DLSS_G = 2,
+		FEATURE_REFLEX = 3,
+		FEATURE_PCL = 4,
+	};
+
+	VkInstance instance = VK_NULL_HANDLE;
+	VkDevice device = VK_NULL_HANDLE;
+	bool active = false;
+
+	static void _append_unique(LocalVector<CharString> &r_list, const CharString &p_name) {
+		for (const CharString &name : r_list) {
+			if (name == p_name) {
+				return;
+			}
+		}
+		r_list.push_back(p_name);
+	}
+
+	static void _or_features(VkBool32 *r_dst, const VkBool32 *p_src, size_t p_bytes) {
+		for (size_t i = 0; i < p_bytes / sizeof(VkBool32); i++) {
+			r_dst[i] = r_dst[i] || p_src[i];
+		}
+	}
+
+public:
+	bool is_active() const { return active; }
+
+	virtual const char *get_name() const override { return "nvidia"; }
+
+	virtual void get_instance_extensions(LocalVector<CharString> &r_required, LocalVector<CharString> &r_optional) override {
+		StreamlineContext &ctx = StreamlineContext::get();
+		for (int i = 0; i < StreamlineContext::FEATURE_COUNT; i++) {
+			for (const CharString &name : ctx.requirements[i].instance_extensions) {
+				_append_unique(r_optional, name);
+			}
+		}
+	}
+
+	virtual uint32_t get_minimum_api_version() const override {
+		StreamlineContext &ctx = StreamlineContext::get();
+		for (int i = 0; i < StreamlineContext::FEATURE_COUNT; i++) {
+			if (!ctx.requirements[i].features13.is_empty()) {
+				return VK_API_VERSION_1_3;
+			}
+		}
+		return VK_API_VERSION_1_2;
+	}
+
+	virtual void instance_created(VkInstance p_instance, PFN_vkGetInstanceProcAddr p_get_instance_proc_addr) override {
+		instance = p_instance;
+	}
+
+	virtual void get_device_extensions(VkPhysicalDevice p_physical_device, LocalVector<CharString> &r_required, LocalVector<CharString> &r_optional) override {
+		// All optional: a missing extension disables the feature that asked for
+		// it (see device_created) instead of failing device creation.
+		StreamlineContext &ctx = StreamlineContext::get();
+		for (int i = 0; i < StreamlineContext::FEATURE_COUNT; i++) {
+			for (const CharString &name : ctx.requirements[i].device_extensions) {
+				_append_unique(r_optional, name);
+			}
+		}
+	}
+
+	virtual void adjust_device_features(VkPhysicalDevice p_physical_device, VkPhysicalDeviceFeatures2 *r_features2, VkPhysicalDeviceVulkan12Features *r_features12, VkPhysicalDeviceVulkan13Features *r_features13) override {
+		StreamlineContext &ctx = StreamlineContext::get();
+		for (int i = 0; i < StreamlineContext::FEATURE_COUNT; i++) {
+			const StreamlineContext::VulkanRequirements &req = ctx.requirements[i];
+			if (r_features12 != nullptr && !req.features12.is_empty()) {
+				LocalVector<const char *> names;
+				for (const CharString &name : req.features12) {
+					names.push_back(name.get_data());
+				}
+				VkPhysicalDeviceVulkan12Features wanted = sl::getVkPhysicalDeviceVulkan12Features(names.size(), names.ptr());
+				const size_t header = offsetof(VkPhysicalDeviceVulkan12Features, samplerMirrorClampToEdge);
+				_or_features((VkBool32 *)((uint8_t *)r_features12 + header), (const VkBool32 *)((const uint8_t *)&wanted + header), sizeof(wanted) - header);
+			}
+			if (r_features13 != nullptr && !req.features13.is_empty()) {
+				LocalVector<const char *> names;
+				for (const CharString &name : req.features13) {
+					names.push_back(name.get_data());
+				}
+				VkPhysicalDeviceVulkan13Features wanted = sl::getVkPhysicalDeviceVulkan13Features(names.size(), names.ptr());
+				const size_t header = offsetof(VkPhysicalDeviceVulkan13Features, robustImageAccess);
+				_or_features((VkBool32 *)((uint8_t *)r_features13 + header), (const VkBool32 *)((const uint8_t *)&wanted + header), sizeof(wanted) - header);
+			}
+		}
+	}
+
+	virtual void get_queue_requests(VkPhysicalDevice p_physical_device, LocalVector<QueueRequest> &r_requests) override {
+		StreamlineContext &ctx = StreamlineContext::get();
+		uint32_t graphics = 0;
+		uint32_t compute = 0;
+		uint32_t optical_flow = 0;
+		for (int i = 0; i < StreamlineContext::FEATURE_COUNT; i++) {
+			graphics += ctx.requirements[i].graphics_queues;
+			compute += ctx.requirements[i].compute_queues;
+			optical_flow = MAX(optical_flow, ctx.requirements[i].optical_flow_queues);
+		}
+		if (graphics > 0) {
+			QueueRequest request;
+			request.required_flags = VK_QUEUE_GRAPHICS_BIT;
+			request.count = graphics;
+			r_requests.push_back(request);
+		}
+		if (compute > 0) {
+			QueueRequest request;
+			request.required_flags = VK_QUEUE_COMPUTE_BIT;
+			request.count = compute;
+			r_requests.push_back(request);
+		}
+		if (optical_flow > 0) {
+			// Native optical flow needs the first queue of a family that serves
+			// nothing else (DLSS-G); without it DLSS-G runs optical flow in interop mode.
+			QueueRequest request;
+			request.required_flags = VK_QUEUE_OPTICAL_FLOW_BIT_NV;
+			request.dedicated_family = true;
+			request.count = optical_flow;
+			r_requests.push_back(request);
+		}
+	}
+
+	virtual bool device_created(const DeviceInfo &p_info) override {
+		StreamlineContext &ctx = StreamlineContext::get();
+		if (!ctx.initialized || ctx.slSetVulkanInfo == nullptr) {
+			return false;
+		}
+		device = p_info.device;
+		instance = p_info.instance;
+
+		sl::VulkanInfo info;
+		info.device = p_info.device;
+		info.instance = p_info.instance;
+		info.physicalDevice = p_info.physical_device;
+		// Defaults: right after Godot's own queue in the graphics family.
+		info.graphicsQueueFamily = p_info.graphics_queue_family;
+		info.graphicsQueueIndex = p_info.graphics_queue_index + 1;
+		info.computeQueueFamily = p_info.graphics_queue_family;
+		info.computeQueueIndex = p_info.graphics_queue_index + 1;
+		bool native_optical_flow = false;
+		for (const QueueRequest &request : p_info.extra_queues) {
+			if (request.family_index == UINT32_MAX) {
+				print_verbose(vformat("Streamline: extra queue with flags 0x%x was not created.", request.required_flags));
+				continue;
+			}
+			if (request.required_flags == VK_QUEUE_GRAPHICS_BIT) {
+				info.graphicsQueueFamily = request.family_index;
+				info.graphicsQueueIndex = request.first_queue_index;
+			} else if (request.required_flags == VK_QUEUE_COMPUTE_BIT) {
+				info.computeQueueFamily = request.family_index;
+				info.computeQueueIndex = request.first_queue_index;
+			} else if (request.required_flags == VK_QUEUE_OPTICAL_FLOW_BIT_NV) {
+				info.opticalFlowQueueFamily = request.family_index;
+				info.opticalFlowQueueIndex = request.first_queue_index;
+				native_optical_flow = request.first_queue_index == 0;
+			}
+		}
+		info.useNativeOpticalFlowMode = native_optical_flow;
+
+		PFun_slSetVulkanInfo *set_vulkan_info = (PFun_slSetVulkanInfo *)ctx.slSetVulkanInfo;
+		sl::Result result = set_vulkan_info(info);
+		if (result != sl::Result::eOk) {
+			ctx.last_error.set((uint32_t)result);
+			ctx.init_reason = String("slSetVulkanInfo failed: ") + StreamlineContext::result_to_string(result);
+			WARN_PRINT("Streamline: " + ctx.init_reason + "; DLSS disabled for this run.");
+			if (ctx.slShutdown) {
+				ctx.slShutdown();
+			}
+			ctx.initialized = false;
+			ctx.slShutdown = nullptr;
+			return false;
+		}
+		ctx.device_ready = true;
+		active = true;
+
+		// A feature whose device extensions are missing cannot run.
+		bool feature_ok[StreamlineContext::FEATURE_COUNT];
+		ctx.missing_device_extensions = String();
+		for (int i = 0; i < StreamlineContext::FEATURE_COUNT; i++) {
+			feature_ok[i] = true;
+			for (const CharString &name : ctx.requirements[i].device_extensions) {
+				bool found = false;
+				for (const CharString &enabled : p_info.enabled_device_extensions) {
+					if (enabled == name) {
+						found = true;
+						break;
+					}
+				}
+				if (!found) {
+					feature_ok[i] = false;
+					if (!ctx.missing_device_extensions.is_empty()) {
+						ctx.missing_device_extensions += " ";
+					}
+					ctx.missing_device_extensions += String::utf8(name.get_data());
+				}
+			}
+		}
+
+		ctx.enumerate_support_vulkan((void *)p_info.physical_device);
+		ctx.streamline_capabilities.dlss_available &= feature_ok[FEATURE_DLSS];
+		ctx.streamline_capabilities.dlss_rr_available &= feature_ok[FEATURE_DLSS_RR];
+		ctx.streamline_capabilities.dlss_g_available &= feature_ok[FEATURE_DLSS_G];
+		ctx.streamline_capabilities.reflex_available &= feature_ok[FEATURE_REFLEX];
+		ctx.streamline_capabilities.pcl_available &= feature_ok[FEATURE_PCL];
+		ctx.init_reason = "ok";
+
+		if (Streamline::get_singleton()) {
+			Streamline::get_singleton()->emit_marker(STREAMLINE_MARKER_AFTER_DEVICE_CREATION);
+		}
+		print_verbose(vformat("Streamline: Vulkan device ready (DLSS %s, RR %s, DLSS-G %s, Reflex %s).",
+				StreamlineContext::result_to_string(ctx.sr_support_result), StreamlineContext::result_to_string(ctx.rr_support_result),
+				StreamlineContext::result_to_string(ctx.fg_support_result), StreamlineContext::result_to_string(ctx.reflex_support_result)));
+		return true;
+	}
+
+	virtual void device_destroying() override {
+		if (Streamline::get_singleton()) {
+			Streamline::get_singleton()->emit_marker(STREAMLINE_MARKER_BEFORE_DEVICE_DESTROY);
+		}
+		active = false;
+		device = VK_NULL_HANDLE;
+	}
+
+	virtual void get_swapchain_functions(SwapchainFunctions &r_functions) override {
+		StreamlineContext &ctx = StreamlineContext::get();
+		PFN_vkGetDeviceProcAddr get_proc = (PFN_vkGetDeviceProcAddr)ctx.vk_get_device_proc_addr;
+		if (get_proc == nullptr || device == VK_NULL_HANDLE) {
+			return;
+		}
+#define SL_HOOK(member, type, name)                                \
+	{                                                              \
+		type hooked = (type)get_proc(device, name);                \
+		if (hooked != nullptr) {                                   \
+			r_functions.member = hooked;                           \
+		} else {                                                   \
+			WARN_PRINT(String("Streamline: no hook for ") + name); \
+		}                                                          \
+	}
+		SL_HOOK(create_swapchain, PFN_vkCreateSwapchainKHR, "vkCreateSwapchainKHR");
+		SL_HOOK(destroy_swapchain, PFN_vkDestroySwapchainKHR, "vkDestroySwapchainKHR");
+		SL_HOOK(get_swapchain_images, PFN_vkGetSwapchainImagesKHR, "vkGetSwapchainImagesKHR");
+		SL_HOOK(acquire_next_image, PFN_vkAcquireNextImageKHR, "vkAcquireNextImageKHR");
+		SL_HOOK(queue_present, PFN_vkQueuePresentKHR, "vkQueuePresentKHR");
+		SL_HOOK(device_wait_idle, PFN_vkDeviceWaitIdle, "vkDeviceWaitIdle");
+#undef SL_HOOK
+	}
+
+	virtual void get_surface_functions(SurfaceFunctions &r_functions) override {
+		StreamlineContext &ctx = StreamlineContext::get();
+		PFN_vkGetInstanceProcAddr get_proc = (PFN_vkGetInstanceProcAddr)ctx.vk_get_instance_proc_addr;
+		if (get_proc == nullptr || instance == VK_NULL_HANDLE) {
+			return;
+		}
+		r_functions.create_win32_surface = get_proc(instance, "vkCreateWin32SurfaceKHR");
+		r_functions.destroy_surface = (PFN_vkDestroySurfaceKHR)get_proc(instance, "vkDestroySurfaceKHR");
+	}
+
+	virtual void present_begin(uint64_t p_frame) override {
+		if (Streamline::get_singleton()) {
+			Streamline::get_singleton()->emit_marker(STREAMLINE_MARKER_BEGIN_PRESENT);
+		}
+	}
+
+	virtual void present_end(uint64_t p_frame) override {
+		if (Streamline::get_singleton()) {
+			Streamline::get_singleton()->emit_marker(STREAMLINE_MARKER_END_PRESENT);
+		}
+	}
+};
+
+static StreamlineVulkanProvider streamline_vulkan_provider;
+
+bool streamline_vulkan_select_owner() {
+	return GraphicsSDKVulkan::select_owner(&streamline_vulkan_provider);
+}
+
+bool streamline_vulkan_is_owner() {
+	return GraphicsSDKVulkan::get_owner() == &streamline_vulkan_provider && streamline_vulkan_provider.is_active();
+}
+
+#else
+
+bool streamline_vulkan_select_owner() {
+	return false;
+}
+
+bool streamline_vulkan_is_owner() {
+	return false;
+}
+
+#endif // STREAMLINE_ENABLED && VULKAN_ENABLED
