diff --git a/drivers/streamline/SCsub b/drivers/streamline/SCsub
new file mode 100644
index 0000000..0b1f4a6
--- /dev/null
+++ b/drivers/streamline/SCsub
@@ -0,0 +1,17 @@
+#!/usr/bin/env python
+from misc.utility.scons_hints import *
+
+Import("env")
+
+env_streamline = env.Clone()
+
+driver_obj = []
+
+# The Streamline singleton is always built; it reports "not compiled" without
+# use_streamline. The SDK code is Windows + Vulkan only (STREAMLINE_ENABLED);
+# the Vulkan include paths and USE_VOLK come from drivers/vulkan/SCsub.
+if env["use_streamline"]:
+    env_streamline.Prepend(CPPPATH=["#thirdparty/streamline/include"])
+
+env_streamline.add_source_files(driver_obj, "*.cpp")
+env.drivers_sources += driver_obj
