+bool isSignedByNVIDIA(const wchar_t* pathToFile)
+{
+    bool valid = false;
+
+    // Now let's make sure this is actually signed by NVIDIA
+
+    DWORD dwEncoding, dwContentType, dwFormatType;
+    HCERTSTORE hStore = NULL;
+    HCRYPTMSG hMsg = NULL;
+    PCMSG_SIGNER_INFO pSignerInfo = NULL;
+    DWORD dwSignerInfo;
