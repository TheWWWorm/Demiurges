+
+StreamlineContext &StreamlineContext::get() {
+	static StreamlineContext _context;
+	return _context;
+}
+
+// Loads sl.interposer.dll only from the executable's directory, and only when
+// it carries a valid NVIDIA signature.
+bool StreamlineContext::load_functions() {
+#ifdef _WIN32
+	String path = OS::get_singleton()->get_executable_path().get_base_dir().path_join("sl.interposer.dll");
+	if (!FileAccess::exists(path)) {
+		init_reason = "sl.interposer.dll not found next to the executable";
+		return false;
+	}
+	Char16String wide_path = path.utf16();
+	if (!sl::security::verifyEmbeddedSignature((const wchar_t *)wide_path.get_data())) {
+		init_reason = "sl.interposer.dll signature verification failed";
+		return false;
+	}
+	HMODULE streamline = LoadLibraryExW((const wchar_t *)wide_path.get_data(), nullptr, LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+	if (streamline == nullptr) {
+		init_reason = "sl.interposer.dll could not be loaded";
+		return false;
+	}
+	interposer = (void *)streamline;
+#define SL_GETPROC(type, name) (type *)(void *)GetProcAddress(streamline, name)
+	this->slInit = SL_GETPROC(PFun_slInit, "slInit");
+	this->slShutdown = SL_GETPROC(PFun_slShutdown, "slShutdown");
+	this->slIsFeatureSupported = SL_GETPROC(PFun_slIsFeatureSupported, "slIsFeatureSupported");
+	this->slIsFeatureLoaded = SL_GETPROC(PFun_slIsFeatureLoaded, "slIsFeatureLoaded");
+	this->slGetFeatureFunction = SL_GETPROC(PFun_slGetFeatureFunction, "slGetFeatureFunction");
+	this->slGetFeatureRequirements = SL_GETPROC(PFun_slGetFeatureRequirements, "slGetFeatureRequirements");
+	this->slGetNewFrameToken = SL_GETPROC(PFun_slGetNewFrameToken, "slGetNewFrameToken");
+	this->slSetFeatureLoaded = SL_GETPROC(PFun_slSetFeatureLoaded, "slSetFeatureLoaded");
+	this->slAllocateResources = SL_GETPROC(PFun_slAllocateResources, "slAllocateResources");
+	this->slFreeResources = SL_GETPROC(PFun_slFreeResources, "slFreeResources");
+	this->slEvaluateFeature = SL_GETPROC(PFun_slEvaluateFeature, "slEvaluateFeature");
+	this->slSetTagForFrame = SL_GETPROC(PFun_slSetTagForFrame, "slSetTagForFrame");
+	this->slSetConstants = SL_GETPROC(PFun_slSetConstants, "slSetConstants");
+#undef SL_GETPROC
+	this->slSetVulkanInfo = (void *)GetProcAddress(streamline, "slSetVulkanInfo");
+	this->vk_get_instance_proc_addr = (void *)GetProcAddress(streamline, "vkGetInstanceProcAddr");
+	this->vk_get_device_proc_addr = (void *)GetProcAddress(streamline, "vkGetDeviceProcAddr");
+	return true;
+#else
+	init_reason = "Streamline is only available on Windows";
+	return false;
+#endif
+}
+
+void StreamlineContext::load_functions_post_init() {
+	if (!initialized || !device_ready) {
+		return;
+	}
+	if (slGetFeatureFunction) {
+		slGetFeatureFunction(sl::kFeatureReflex, "slReflexSetOptions", (void *&)this->slReflexSetOptions);
+		slGetFeatureFunction(sl::kFeatureReflex, "slReflexSleep", (void *&)this->slReflexSleep);
+		slGetFeatureFunction(sl::kFeatureReflex, "slReflexGetState", (void *&)this->slReflexGetState);
+		slGetFeatureFunction(sl::kFeaturePCL, "slPCLSetMarker", (void *&)this->slPCLSetMarker);
+		slGetFeatureFunction(sl::kFeaturePCL, "slPCLSetOptions", (void *&)this->slPCLSetOptions);
+
+		slGetFeatureFunction(sl::kFeatureDLSS, "slDLSSGetOptimalSettings", (void *&)this->slDLSSGetOptimalSettings);
+		slGetFeatureFunction(sl::kFeatureDLSS, "slDLSSGetState", (void *&)this->slDLSSGetState);
+		slGetFeatureFunction(sl::kFeatureDLSS, "slDLSSSetOptions", (void *&)this->slDLSSSetOptions);
+
+		// Asking an unsupported feature for its functions only logs errors.
+		if (streamline_capabilities.dlss_g_available) {
+			slGetFeatureFunction(sl::kFeatureDLSS_G, "slDLSSGGetState", (void *&)this->slDLSSGGetState);
+			slGetFeatureFunction(sl::kFeatureDLSS_G, "slDLSSGSetOptions", (void *&)this->slDLSSGSetOptions);
+		}
+
+		// DLSS Ray Reconstruction (DLSS-RR)
+		slGetFeatureFunction(sl::kFeatureDLSS_RR, "slDLSSDGetOptimalSettings", (void *&)this->slDLSSDGetOptimalSettings);
+		slGetFeatureFunction(sl::kFeatureDLSS_RR, "slDLSSDGetState", (void *&)this->slDLSSDGetState);
+		slGetFeatureFunction(sl::kFeatureDLSS_RR, "slDLSSDSetOptions", (void *&)this->slDLSSDSetOptions);
+	}
+	streamline_capabilities.dlss_available &= slDLSSSetOptions && slDLSSGetOptimalSettings;
+	streamline_capabilities.dlss_rr_available &= slDLSSDSetOptions && slDLSSDGetOptimalSettings && slDLSSDGetState;
+	streamline_capabilities.dlss_g_available &= slDLSSGSetOptions && slDLSSGGetState;
+	streamline_capabilities.reflex_available &= slReflexSetOptions && slReflexSleep;
+	// DLSS-G needs Reflex.
+	streamline_capabilities.dlss_g_available &= streamline_capabilities.reflex_available;
+}
+
+void StreamlineContext::query_requirements() {
+	if (!initialized || !slGetFeatureRequirements) {
+		return;
+	}
+	for (int i = 0; i < FEATURE_COUNT; i++) {
+		VulkanRequirements &out = requirements[i];
+		out = VulkanRequirements();
+		bool loaded = false;
+		if (slIsFeatureLoaded && (slIsFeatureLoaded(features[i], loaded) != sl::Result::eOk || !loaded)) {
+			continue;
+		}
+		sl::FeatureRequirements req;
+		if (slGetFeatureRequirements(features[i], req) != sl::Result::eOk) {
+			continue;
+		}
+		out.loaded = true;
+		for (uint32_t j = 0; j < req.vkNumInstanceExtensions; j++) {
+			out.instance_extensions.push_back(CharString(req.vkInstanceExtensions[j]));
+		}
+		for (uint32_t j = 0; j < req.vkNumDeviceExtensions; j++) {
+			out.device_extensions.push_back(CharString(req.vkDeviceExtensions[j]));
+		}
+		for (uint32_t j = 0; j < req.vkNumFeatures12; j++) {
+			out.features12.push_back(CharString(req.vkFeatures12[j]));
+		}
+		for (uint32_t j = 0; j < req.vkNumFeatures13; j++) {
+			out.features13.push_back(CharString(req.vkFeatures13[j]));
+		}
+		out.graphics_queues = req.vkNumGraphicsQueuesRequired;
+		out.compute_queues = req.vkNumComputeQueuesRequired;
+		out.optical_flow_queues = req.vkNumOpticalFlowQueuesRequired;
+		if (OS::get_singleton()->is_stdout_verbose()) {
+			String line = vformat("Streamline: feature %d needs %d graphics, %d compute, %d optical flow queues; device extensions:", (int)features[i], out.graphics_queues, out.compute_queues, out.optical_flow_queues);
+			for (const CharString &e : out.device_extensions) {
+				line += " " + String::utf8(e.get_data());
+			}
+			line += "; instance extensions:";
+			for (const CharString &e : out.instance_extensions) {
+				line += " " + String::utf8(e.get_data());
+			}
+			print_line(line);
+		}
+	}
+}
+
+void StreamlineContext::enumerate_support_vulkan(void *vk_physical_device) {
+	StreamlineCapabilities support;
+	if (initialized && slIsFeatureSupported) {
+		sl::AdapterInfo adapter_info;
+		adapter_info.vkPhysicalDevice = vk_physical_device;
+		sr_support_result = slIsFeatureSupported(sl::kFeatureDLSS, adapter_info);
+		fg_support_result = slIsFeatureSupported(sl::kFeatureDLSS_G, adapter_info);
+		rr_support_result = slIsFeatureSupported(sl::kFeatureDLSS_RR, adapter_info);
+		reflex_support_result = slIsFeatureSupported(sl::kFeatureReflex, adapter_info);
+		support.dlss_available = sr_support_result == sl::Result::eOk;
+		support.dlss_g_available = fg_support_result == sl::Result::eOk;
+		support.dlss_rr_available = rr_support_result == sl::Result::eOk;
+		support.reflex_available = reflex_support_result == sl::Result::eOk;
+		support.pcl_available = slIsFeatureSupported(sl::kFeaturePCL, adapter_info) == sl::Result::eOk;
+		support.nis_available = false;
+	}
+	streamline_capabilities = support;
+}
+
+#define STREAMLINE_GAME_ONLY \
+	if (!is_game || !initialized) \
+		return;
+
+void StreamlineContext::dlssg_disable() {
+	STREAMLINE_GAME_ONLY; // Disable DLSS-G for editor or project settings.
+
+	if (slDLSSGSetOptions && (uint32_t)dlssg_viewport != UINT_MAX) {
+		dlssg_delay = 10;
+		fg_active.set(0);
+
+		sl::DLSSGOptions dlssGOptions{};
+		dlssGOptions.mode = sl::DLSSGMode::eOff;
+		slDLSSGSetOptions(dlssg_viewport, dlssGOptions);
+
+		dlssg_viewport = sl::ViewportHandle(-1);
+	}
+}
+
+void StreamlineContext::reflex_set_options(const sl::ReflexOptions &opts) {
+	STREAMLINE_GAME_ONLY; // Disable reflex for editor or project settings.
+
+	reflex_options = opts;
+	reflex_options_dirty = false;
+	sl::Result result = this->slReflexSetOptions ? this->slReflexSetOptions(opts) : sl::Result::eOk;
+	if (!check(result, true)) { return; }
+}
+
+void StreamlineContext::pcl_set_options(const sl::PCLOptions &opts) {
+	STREAMLINE_GAME_ONLY; // Disable PCL for editor or project settings.
+
+	pcl_options = opts;
+	pcl_options_dirty = false;
+	sl::Result result = this->slPCLSetOptions ? this->slPCLSetOptions(opts) : sl::Result::eOk;
+	if (!check(result, true)) { return; }
+}
+
+void StreamlineContext::pcl_marker(sl::FrameToken *frameToken, sl::PCLMarker marker) {
+	STREAMLINE_GAME_ONLY; // Disable PCL for editor or project settings.
+
+	sl::Result result = this->slPCLSetMarker ? this->slPCLSetMarker(marker, *frameToken) : sl::Result::eOk;
+	if (!check(result, true)) { return; }
+}
+
+void StreamlineContext::reflex_sleep(sl::FrameToken *frameToken) {
+	STREAMLINE_GAME_ONLY; // Disable reflex for editor or project settings.
+
+	if (frameToken == nullptr) {
+		return;
+	}
+
+	sl::Result result = this->slReflexSleep ? this->slReflexSleep(*frameToken) : sl::Result::eOk;
+	if (!check(result, true)) { return; }
+}
+
+void StreamlineContext::reflex_get_state(sl::ReflexState &reflexState) {
+	STREAMLINE_GAME_ONLY; // Disable reflex for editor or project settings.
+
+	sl::Result result = this->slReflexGetState ? this->slReflexGetState(reflexState) : sl::Result::eOk;
+	if (!check(result, true)) { return; }
+}
+
+sl::FrameToken *StreamlineContext::get_new_frame_token() {
+	if (!initialized || !device_ready) { return nullptr; }
+	sl::Result result = this->slGetNewFrameToken ? this->slGetNewFrameToken(last_token, nullptr) : sl::Result::eOk;
+	ERR_FAIL_COND_V_MSG(result != sl::Result::eOk, nullptr, StreamlineContext::result_to_string(result));
+	frame_token_rendered = false;
+	return last_token;
+}
+
+const char *StreamlineContext::result_to_string(sl::Result result) {
+	switch (result) {
+		case sl::Result::eOk:
+			return "sl::eOk";
+		case sl::Result::eErrorIO:
+			return "sl::eErrorIO";
+		case sl::Result::eErrorDriverOutOfDate:
+			return "sl::eErrorDriverOutOfDate";
+		case sl::Result::eErrorOSOutOfDate:
+			return "sl::eErrorOSOutOfDate";
+		case sl::Result::eErrorOSDisabledHWS:
+			return "sl::eErrorOSDisabledHWS";
+		case sl::Result::eErrorDeviceNotCreated:
+			return "sl::eErrorDeviceNotCreated";
+		case sl::Result::eErrorNoSupportedAdapterFound:
+			return "sl::eErrorNoSupportedAdapterFound";
+		case sl::Result::eErrorAdapterNotSupported:
+			return "sl::eErrorAdapterNotSupported";
+		case sl::Result::eErrorNoPlugins:
+			return "sl::eErrorNoPlugins";
+		case sl::Result::eErrorVulkanAPI:
+			return "sl::eErrorVulkanAPI";
+		case sl::Result::eErrorDXGIAPI:
+			return "sl::eErrorDXGIAPI";
+		case sl::Result::eErrorD3DAPI:
+			return "sl::eErrorD3DAPI";
+		case sl::Result::eErrorNRDAPI:
+			return "sl::eErrorNRDAPI";
+		case sl::Result::eErrorNVAPI:
+			return "sl::eErrorNVAPI";
+		case sl::Result::eErrorReflexAPI:
+			return "sl::eErrorReflexAPI";
+		case sl::Result::eErrorNGXFailed:
+			return "sl::eErrorNGXFailed";
+		case sl::Result::eErrorJSONParsing:
+			return "sl::eErrorJSONParsing";
+		case sl::Result::eErrorMissingProxy:
+			return "sl::eErrorMissingProxy";
+		case sl::Result::eErrorMissingResourceState:
+			return "sl::eErrorMissingResourceState";
+		case sl::Result::eErrorInvalidIntegration:
+			return "sl::eErrorInvalidIntegration";
+		case sl::Result::eErrorMissingInputParameter:
+			return "sl::eErrorMissingInputParameter";
+		case sl::Result::eErrorNotInitialized:
+			return "sl::eErrorNotInitialized";
+		case sl::Result::eErrorComputeFailed:
+			return "sl::eErrorComputeFailed";
+		case sl::Result::eErrorInitNotCalled:
+			return "sl::eErrorInitNotCalled";
+		case sl::Result::eErrorExceptionHandler:
+			return "sl::eErrorExceptionHandler";
+		case sl::Result::eErrorInvalidParameter:
+			return "sl::eErrorInvalidParameter";
+		case sl::Result::eErrorMissingConstants:
+			return "sl::eErrorMissingConstants";
+		case sl::Result::eErrorDuplicatedConstants:
+			return "sl::eErrorDuplicatedConstants";
+		case sl::Result::eErrorMissingOrInvalidAPI:
+			return "sl::eErrorMissingOrInvalidAPI";
+		case sl::Result::eErrorCommonConstantsMissing:
+			return "sl::eErrorCommonConstantsMissing";
+		case sl::Result::eErrorUnsupportedInterface:
+			return "sl::eErrorUnsupportedInterface";
+		case sl::Result::eErrorFeatureMissing:
+			return "sl::eErrorFeatureMissing";
+		case sl::Result::eErrorFeatureNotSupported:
+			return "sl::eErrorFeatureNotSupported";
+		case sl::Result::eErrorFeatureMissingHooks:
+			return "sl::eErrorFeatureMissingHooks";
+		case sl::Result::eErrorFeatureFailedToLoad:
+			return "sl::eErrorFeatureFailedToLoad";
+		case sl::Result::eErrorFeatureWrongPriority:
+			return "sl::eErrorFeatureWrongPriority";
+		case sl::Result::eErrorFeatureMissingDependency:
+			return "sl::eErrorFeatureMissingDependency";
+		case sl::Result::eErrorFeatureManagerInvalidState:
+			return "sl::eErrorFeatureManagerInvalidState";
+		case sl::Result::eErrorInvalidState:
+			return "sl::eErrorInvalidState";
+		case sl::Result::eWarnOutOfVRAM:
+			return "sl::eWarnOutOfVRAM";
+		default:
+			return "sl::eUnknown";
+	}
+}
+
+void StreamlineContext::initialize() {
+	StreamlineContext &context = StreamlineContext::get();
+	context.is_game = !(Engine::get_singleton()->is_editor_hint() || Engine::get_singleton()->is_project_manager_hint());
+
+	if (context.slInit != nullptr) {
+		return; // Already initialized.
+	}
+
+	if (!context.load_functions()) {
+		return;
+	}
+	if (!context.slInit || !context.slShutdown || !context.slIsFeatureSupported || !context.slGetFeatureFunction ||
+			!context.slSetConstants || !context.slSetTagForFrame || !context.slEvaluateFeature ||
+			!context.slGetNewFrameToken || !context.slFreeResources || !context.slGetFeatureRequirements ||
+			!context.slSetVulkanInfo || !context.vk_get_device_proc_addr || !context.vk_get_instance_proc_addr) {
+		context.init_reason = "sl.interposer.dll lacks required exports";
+		context.slInit = nullptr;
+		return;
+	}
+
+	sl::Preferences pref;
+	pref.featuresToLoad = context.features;
+	pref.numFeaturesToLoad = FEATURE_COUNT;
+	pref.renderAPI = sl::RenderAPI::eVulkan;
+	pref.applicationId = 0;
+	pref.engine = sl::EngineType::eCustom;
+	pref.engineVersion = "Godot 4.7 / Demiurges";
+	pref.projectId = "5d1f8c7e-3b2a-4d6e-9f40-7a1c2e8b9d36";
+	// Vulkan manual hooking: Godot creates the instance and device itself and
+	// routes only the hooked swapchain and surface calls through Streamline.
+	pref.flags = sl::PreferenceFlags::eDisableCLStateTracking | sl::PreferenceFlags::eUseFrameBasedResourceTagging | sl::PreferenceFlags::eUseManualHooking;
+
+	if (bool(GLOBAL_GET("rendering/streamline/streamline_log")) || OS::get_singleton()->is_stdout_verbose()) {
+		pref.logLevel = sl::LogLevel::eVerbose;
+		pref.showConsole = false;
+		pref.logMessageCallback = [](sl::LogType p_type, const char *p_message) {
+			print_line("Streamline: " + String::utf8(p_message).strip_edges());
+		};
+	} else {
+		pref.logLevel = sl::LogLevel::eOff;
+		pref.showConsole = false;
+	}
+	sl::Result result = context.slInit(pref, sl::kSDKVersion);
+	context.initialized = result == sl::Result::eOk;
+	context.last_error.set((uint32_t)result);
+	if (!context.initialized) {
+		context.init_reason = String("slInit failed: ") + result_to_string(result);
+		return;
+	}
+	context.init_reason = "waiting for the Vulkan device";
+	context.query_requirements();
+}
+
+bool StreamlineContext::check(sl::Result result, bool frame_generation) {
+	if (result == sl::Result::eOk) { return true; }
+	last_error.set((uint32_t)result);
+	if (frame_generation) { fg_failed.set(1); } else { sr_failed.set(1); }
+	dlssg_disable();
+	WARN_PRINT("NVIDIA experiment disabled after SDK error: " + String(result_to_string(result)));
+	return false;
+}
+
+bool StreamlineContext::check_rr(sl::Result result) {
+	if (result == sl::Result::eOk) { return true; }
+	rr_last_error.set((uint32_t)result);
+	rr_failed.set(1);
+	rr_active.set(0);
+	// An optional RR failure must not disable ordinary SR/DLAA.
+	WARN_PRINT("DLSS Ray Reconstruction unavailable after SDK error: " + String(result_to_string(result)));
+	return false;
+}
+
+void StreamlineContext::poll_presented_frames() {
+	if (!initialized || !slDLSSGGetState || (uint32_t)dlssg_viewport == UINT_MAX) { return; }
+	sl::DLSSGState state;
+	if (!check(slDLSSGGetState(dlssg_viewport, state, nullptr), true)) { return; }
+	presented_frames.add(state.numFramesActuallyPresented);
+	fg_status.set((uint32_t)state.status);
+	if (state.status != sl::DLSSGStatus::eOk) {
+		fg_failed.set(1);
+		dlssg_disable();
+	}
+}
+
+#endif
