+    if (!pfnCertOpenStore)
+    {
+        // We only support Win10+ so we can search for module in system32 directly
+        auto hModCrypt32 = LoadLibraryExW(L"crypt32.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+        if (!hModCrypt32 ||
+            !GetProc(hModCrypt32, "CryptMsgClose", pfnCryptMsgClose) ||
